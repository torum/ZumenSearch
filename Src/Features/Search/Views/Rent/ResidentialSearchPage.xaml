<Page
    x:Class="ZumenSearch.Views.Rent.ResidentialSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d"
    xmlns:mod="using:ZumenSearch.Models"
    xmlns:residential="using:ZumenSearch.Models.Rent.Residentials"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentArea" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="{StaticResource ContentPadding}">
            <Grid BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <BreadcrumbBar x:Name="BreadcrumbBar1" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind ViewModel.BreadcrumbItemsResidential, Mode=OneWay}" VerticalAlignment="Center">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="mod:Breadcrumb">
                            <BreadcrumbBarItem>
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate x:DataType="mod:Breadcrumb">
                                        <TextBlock Text="{x:Bind Name}" FontSize="28" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                        <AppBarButton Icon="Find" Label="検索" Command="{x:Bind ViewModel.SearchRentResidentialListingCommand}" CommandParameter="{x:Bind SearchCriteria}"/>
                        <AppBarButton Icon="Add" Label="新規" Command="{x:Bind ViewModel.AddNewRentResidentialCommand}"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource ContentPadding}">
            <ScrollViewer x:Name="BodyScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Padding="0,0,24,0">
                <StackPanel x:Name="BodyGrid" Width="{x:Bind BodyScrollViewer.ViewportWidth, Mode=OneWay}" MaxWidth="1100" HorizontalAlignment="Center" Spacing="12" Padding="0,24,0,24">
                    <TextBlock Text="基本条件" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
                    <Grid x:Name="BasicFieldsGrid" SizeChanged="BasicFieldsGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="BasicSecondColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TextBoxName" Grid.Row="0" Grid.Column="0" Header="物件名" PlaceholderText="物件名を入力" Margin="0,0,0,16" Text="{x:Bind SearchCriteria.PropertyName, Mode=TwoWay}"/>
                        <TextBox x:Name="AddressTextBox" Grid.Row="1" Grid.Column="0" Header="所在地" PlaceholderText="所在地を入力" Margin="0,0,0,16" Text="{x:Bind SearchCriteria.Address, Mode=TwoWay}"/>
                        <TextBox x:Name="StationTextBox" Grid.Row="2" Grid.Column="0" Header="最寄り駅" PlaceholderText="駅名を入力" Margin="0,0,0,16" Text="{x:Bind SearchCriteria.Station, Mode=TwoWay}"/>
                        <TextBox x:Name="LineTextBox" Grid.Row="3" Grid.Column="0" Header="沿線名" PlaceholderText="沿線名を入力" Margin="0,0,0,16" Text="{x:Bind SearchCriteria.Line, Mode=TwoWay}"/>
                        <TextBox x:Name="LessorTextBox" Grid.Row="4" Grid.Column="0" Header="貸主名" PlaceholderText="貸主名を入力" Margin="0,0,0,16" Text="{x:Bind SearchCriteria.LessorName, Mode=TwoWay}"/>
                        <TextBox x:Name="RealEstateIdTextBox" Grid.Row="5" Grid.Column="0" Header="不動産ID" PlaceholderText="不動産IDを入力" Margin="0,0,0,16" Text="{x:Bind SearchCriteria.FudousanId, Mode=TwoWay}"/>
                    </Grid>

                    <TextBlock Text="詳細条件" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,24,0,0"/>
                    <TextBlock Text="必要な項目を開いて条件を指定できます。" TextWrapping="Wrap"/>

                    <Expander Header="賃料等条件" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,0,0,12">
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <NumberBox Header="賃料 下限（円）" Minimum="0" Width="160" Margin="0,0,12,12" PlaceholderText="下限なし" Value="{x:Bind SearchCriteria.MinimumRent, Mode=TwoWay}"/>
                                <NumberBox Header="賃料 上限（円）" Minimum="0" Width="160" Margin="0,0,12,12" PlaceholderText="上限なし" Value="{x:Bind SearchCriteria.MaximumRent, Mode=TwoWay}"/>
                                <NumberBox Header="管理費 上限（円）" Minimum="0" Width="160" Margin="0,0,12,12" PlaceholderText="上限なし" Value="{x:Bind SearchCriteria.MaximumManagementFee, Mode=TwoWay}"/>
                            </VariableSizedWrapGrid>
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <CheckBox Content="敷金なし" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.NoSecurityDeposit, Mode=TwoWay}"/>
                                <CheckBox Content="礼金なし" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.NoKeyMoney, Mode=TwoWay}"/>
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="交通" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <NumberBox Header="駅徒歩 上限（分）" Minimum="0" Width="180" HorizontalAlignment="Left" PlaceholderText="上限なし" Margin="0,0,0,12" Value="{x:Bind SearchCriteria.MaximumStationWalkMinutes, Mode=TwoWay}"/>
                    </Expander>

                    <Expander Header="建物種別・建物構造" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,0,0,12">
                            <TextBlock Text="建物種別"/>
                            <ItemsRepeater ItemsSource="{x:Bind PropertyKinds}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="160" MinColumnSpacing="16" MinRowSpacing="4"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="residential:PropertyKindTypeLabel">
                                        <CheckBox Content="{x:Bind Label}" Tag="{x:Bind Key}" Checked="SearchOption_Checked" Unchecked="SearchOption_Unchecked"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Text="建物構造" Margin="0,8,0,0"/>
                            <ItemsRepeater ItemsSource="{x:Bind PropertyStructures}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="260" MinColumnSpacing="16" MinRowSpacing="4"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="residential:PropertyStructureTypeLabel">
                                        <CheckBox Content="{x:Bind Label}" Tag="{x:Bind Key}" Checked="SearchOption_Checked" Unchecked="SearchOption_Unchecked"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <NumberBox Header="築年数 上限（年）" Minimum="0" Width="180" HorizontalAlignment="Left" PlaceholderText="上限なし" Margin="0,8,0,0" Value="{x:Bind SearchCriteria.MaximumBuildingAgeYears, Mode=TwoWay}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="間取り・専有面積" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,0,0,12">
                            <TextBlock Text="間取り"/>
                            <ItemsRepeater ItemsSource="{x:Bind FloorPlans}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="100" MinColumnSpacing="16" MinRowSpacing="4"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="residential:ListingFloorPlanTypeLabel">
                                        <CheckBox Content="{x:Bind Label}" Tag="{x:Bind Key}" Checked="SearchOption_Checked" Unchecked="SearchOption_Unchecked"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <VariableSizedWrapGrid Orientation="Horizontal" Margin="0,8,0,0">
                                <NumberBox Header="専有面積 下限（㎡）" Minimum="0" Width="180" Margin="0,0,12,12" PlaceholderText="下限なし" Value="{x:Bind SearchCriteria.MinimumFloorArea, Mode=TwoWay}"/>
                                <NumberBox Header="専有面積 上限（㎡）" Minimum="0" Width="180" Margin="0,0,12,12" PlaceholderText="上限なし" Value="{x:Bind SearchCriteria.MaximumFloorArea, Mode=TwoWay}"/>
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="条件" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <VariableSizedWrapGrid Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="ペット可" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.PetFriendly, Mode=TwoWay}"/>
                            <CheckBox Content="二人入居可" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.TwoPersonOccupancy, Mode=TwoWay}"/>
                            <CheckBox Content="保証人不要" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.NoGuarantorNeeded, Mode=TwoWay}"/>
                            <CheckBox Content="事務所利用可" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.OfficeUseAllowed, Mode=TwoWay}"/>
                        </VariableSizedWrapGrid>
                    </Expander>

                    <Expander Header="取引・手数料" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,0,0,12">
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <ComboBox Header="物件の取扱区分" Width="180" Margin="0,0,12,12" PlaceholderText="指定なし" ItemsSource="{x:Bind HandlingTypes}" SelectedItem="{x:Bind SearchCriteria.HandlingType, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="residential:ListingHandlingTypeLabel">
                                            <TextBlock Text="{x:Bind Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Header="取引態様" Width="180" Margin="0,0,12,12" PlaceholderText="指定なし" ItemsSource="{x:Bind TransactionTypes}" SelectedItem="{x:Bind SearchCriteria.TransactionType, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="residential:ListingTransactionTypeLabel">
                                            <TextBlock Text="{x:Bind Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </VariableSizedWrapGrid>
                            <TextBlock Text="手数料"/>
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="貸主"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <NumberBox Width="110" Minimum="0" PlaceholderText="指定なし" AutomationProperties.Name="貸主手数料" Value="{x:Bind SearchCriteria.MaximumLessorCommission, Mode=TwoWay}"/>
                                        <ComboBox Width="100" PlaceholderText="単位" AutomationProperties.Name="貸主手数料の単位" ItemsSource="{x:Bind CommissionUnits}" SelectedItem="{x:Bind SearchCriteria.LessorCommissionUnit, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="residential:ListingCommissionUnitTypeLabel">
                                                    <TextBlock Text="{x:Bind Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="借主"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <NumberBox Width="110" Minimum="0" PlaceholderText="指定なし" AutomationProperties.Name="借主手数料" Value="{x:Bind SearchCriteria.MaximumLesseeCommission, Mode=TwoWay}"/>
                                        <ComboBox Width="100" PlaceholderText="単位" AutomationProperties.Name="借主手数料の単位" ItemsSource="{x:Bind CommissionUnits}" SelectedItem="{x:Bind SearchCriteria.LesseeCommissionUnit, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="residential:ListingCommissionUnitTypeLabel">
                                                    <TextBlock Text="{x:Bind Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="元付"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <NumberBox Width="110" Minimum="0" PlaceholderText="指定なし" AutomationProperties.Name="元付手数料" Value="{x:Bind SearchCriteria.MaximumListingBrokerCommission, Mode=TwoWay}"/>
                                        <ComboBox Width="100" PlaceholderText="単位" AutomationProperties.Name="元付手数料の単位" ItemsSource="{x:Bind CommissionUnits}" SelectedItem="{x:Bind SearchCriteria.ListingBrokerCommissionUnit, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="residential:ListingCommissionUnitTypeLabel">
                                                    <TextBlock Text="{x:Bind Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="客付け"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <NumberBox Width="110" Minimum="0" PlaceholderText="指定なし" AutomationProperties.Name="客付け手数料" Value="{x:Bind SearchCriteria.MaximumTenantBrokerCommission, Mode=TwoWay}"/>
                                        <ComboBox Width="100" PlaceholderText="単位" AutomationProperties.Name="客付け手数料の単位" ItemsSource="{x:Bind CommissionUnits}" SelectedItem="{x:Bind SearchCriteria.TenantBrokerCommissionUnit, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="residential:ListingCommissionUnitTypeLabel">
                                                    <TextBlock Text="{x:Bind Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="その他" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Padding="0,0,0,12">
                            <TextBlock Text="募集・入居"/>
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <CheckBox Content="募集中" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.IsRecruiting, Mode=TwoWay}"/>
                                <CheckBox Content="即入居可" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.ImmediateOccupancy, Mode=TwoWay}"/>
                                <CheckBox Content="角部屋" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.CornerRoom, Mode=TwoWay}"/>
                            </VariableSizedWrapGrid>
                            <TextBlock Text="設備"/>
                            <VariableSizedWrapGrid Orientation="Horizontal">
                                <CheckBox Content="オートロック" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasAutolock, Mode=TwoWay}"/>
                                <CheckBox Content="エレベーター" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasElevator, Mode=TwoWay}"/>
                                <CheckBox Content="宅配ボックス" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasParcelLocker, Mode=TwoWay}"/>
                                <CheckBox Content="インターネット無料" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasFreeInternet, Mode=TwoWay}"/>
                                <CheckBox Content="エアコン" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasAirConditioner, Mode=TwoWay}"/>
                                <CheckBox Content="バス・トイレ別" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasSeparateBathAndToilet, Mode=TwoWay}"/>
                                <CheckBox Content="駐車場" Margin="0,0,24,8" IsChecked="{x:Bind SearchCriteria.HasParking, Mode=TwoWay}"/>
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</Page>
