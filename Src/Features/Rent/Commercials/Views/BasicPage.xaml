<Page x:Class="ZumenSearch.Views.Rent.Commercials.BasicPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:modcom="using:ZumenSearch.Models.Rent.Commercials" mc:Ignorable="d" NavigationCacheMode="Required">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BasicSecondColumn.Width" Value="*" />
                        <Setter Target="PropertyKind.(Grid.Row)" Value="0" />
                        <Setter Target="PropertyKind.(Grid.Column)" Value="1" />
                        <Setter Target="UnitOwnership.(Grid.Row)" Value="1" />
                        <Setter Target="BuildingSecondColumn.Width" Value="*" />
                        <Setter Target="BasementFloors.(Grid.Row)" Value="1" />
                        <Setter Target="BasementFloors.(Grid.Column)" Value="1" />
                        <Setter Target="FloorArea.(Grid.Row)" Value="2" />
                        <Setter Target="BuiltDate.(Grid.Row)" Value="2" />
                        <Setter Target="BuiltDate.(Grid.Column)" Value="1" />
                        <Setter Target="IdentificationSecondColumn.Width" Value="*" />
                        <Setter Target="SpecificCode.(Grid.Row)" Value="0" />
                        <Setter Target="SpecificCode.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
            <StackPanel Spacing="12" Margin="0,24,0,0">
                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="BasicSecondColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Row="0" Header="物件名" PlaceholderText="必須" MaxLength="100" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox x:Name="PropertyKind" Grid.Row="1" Header="物件種目" PlaceholderText="選択" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="modcom:PropertyTypeLabel">
                                    <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox x:Name="UnitOwnership" Grid.Row="2" Content="区分所有" IsChecked="{x:Bind ViewModel.IsUnitOwnership, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="BuildingSecondColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Row="0" Header="建物構造" PlaceholderText="選択" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Structures, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStructure, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="modcom:PropertyStructureTypeLabel">
                                    <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Row="1" Header="地上階数（階）" InputScope="Number" Text="{x:Bind ViewModel.FloorCountAboveGround, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox x:Name="BasementFloors" Grid.Row="2" Header="地下階数（階）" InputScope="Number" Text="{x:Bind ViewModel.FloorCountBasement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox x:Name="FloorArea" Grid.Row="3" Header="延床面積（㎡）" InputScope="Number" Text="{x:Bind ViewModel.TotalFloorArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DatePicker x:Name="BuiltDate" Grid.Row="4" Header="築年月" DayVisible="False" Language="ja-JP" SelectedDate="{x:Bind ViewModel.BuiltYearAndMonth, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="IdentificationSecondColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Row="0" Header="不動産番号" Text="{x:Bind ViewModel.FudousanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox x:Name="SpecificCode" Grid.Row="1" Header="特定コード" Text="{x:Bind ViewModel.FudousanIdAdditionalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False" MinHeight="160" Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>