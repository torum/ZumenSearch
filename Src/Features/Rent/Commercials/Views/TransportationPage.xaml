<Page x:Class="ZumenSearch.Views.Rent.Commercials.TransportationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:CommunityToolkit.WinUI.Controls" mc:Ignorable="d" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <StackPanel Spacing="12" Margin="0,24,0,0">
            <controls:Segmented HorizontalAlignment="Center" SelectedIndex="{x:Bind ViewModel.SelectedTransportationIndex, Mode=TwoWay}">
                <controls:SegmentedItem Content="交通１" />
                <controls:SegmentedItem Content="交通２" />
                <controls:SegmentedItem Content="交通３" />
                <controls:SegmentedItem Content="交通４" />
            </controls:Segmented>
            <Border HorizontalAlignment="Stretch" Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="鉄道" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Header="路線" IsReadOnly="True" Text="{x:Bind ViewModel.SelectedTransportation.RailLine.LineName, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="選択" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ShowRailLineSelectCommand}" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Header="駅名" IsReadOnly="True" Text="{x:Bind ViewModel.SelectedTransportation.RailStation.StationName, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="選択" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ShowRailStationSelectCommand}" />
                    </Grid>
                    <TextBox Header="駅から徒歩（分）" InputScope="Number" MaxLength="4" Text="{x:Bind ViewModel.SelectedTransportation.StationWalk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Stretch" Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="バス" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBox Header="バス停名" Text="{x:Bind ViewModel.SelectedTransportation.BusStop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="バス乗車時間（分）" InputScope="Number" MaxLength="4" Text="{x:Bind ViewModel.SelectedTransportation.BusRide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="バス停から徒歩（分）" InputScope="Number" MaxLength="4" Text="{x:Bind ViewModel.SelectedTransportation.BusWalk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

