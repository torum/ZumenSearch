<Page x:Class="ZumenSearch.Views.Rent.Commercials.Listing.ContractPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:listing="using:ZumenSearch.Models.Rent.Commercials.Listing" mc:Ignorable="d" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,36,24">
        <StackPanel Spacing="12" Margin="0,24,0,0">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBox Header="賃料（月額・円）" InputScope="Number" Text="{x:Bind ViewModel.Chinryou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="賃料の消費税" ItemsSource="{x:Bind ViewModel.ContractTaxTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRentTax, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingContractTaxTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="共益費・管理費（月額・円）" InputScope="Number" Text="{x:Bind ViewModel.ManagementFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="共益費・管理費の消費税" ItemsSource="{x:Bind ViewModel.ContractTaxTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedManagementFeeTax, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingContractTaxTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBox Header="敷金" InputScope="Number" Text="{x:Bind ViewModel.SecurityDeposit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="敷金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSecurityDepositUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="保証金" InputScope="Number" Text="{x:Bind ViewModel.GuaranteeDeposit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="保証金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGuaranteeDepositUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="礼金" InputScope="Number" Text="{x:Bind ViewModel.KeyMoney, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="礼金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKeyMoneyUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="権利金" InputScope="Number" Text="{x:Bind ViewModel.RightsMoney, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="権利金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRightsMoneyUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="敷引・償却金" InputScope="Number" Text="{x:Bind ViewModel.DepositDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="敷引・償却金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDepositDeductionUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox Header="契約種別" ItemsSource="{x:Bind ViewModel.ContractTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedContractType, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingContractTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="契約期間（年）" InputScope="Number" Text="{x:Bind ViewModel.ContractPeriodYears, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="更新料" InputScope="Number" Text="{x:Bind ViewModel.RenewalFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="更新料の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRenewalFeeUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="再契約手数料" InputScope="Number" Text="{x:Bind ViewModel.RecontractFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="再契約手数料の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRecontractFeeUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBox Header="保証会社" Text="{x:Bind ViewModel.GuarantorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="保険" Text="{x:Bind ViewModel.Insurance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="その他費用" Text="{x:Bind ViewModel.OtherFees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="その他条件" Text="{x:Bind ViewModel.ContractConditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="契約備考" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" Text="{x:Bind ViewModel.ContractRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
