<Page x:Class="ZumenSearch.Views.Rent.Commercials.Listing.TransactionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:listing="using:ZumenSearch.Models.Rent.Commercials.Listing" mc:Ignorable="d" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <StackPanel Spacing="12" Margin="0,24,0,0">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox Header="物件の取扱区分" ItemsSource="{x:Bind ViewModel.HandlingTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedHandlingType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingHandlingTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Header="取引態様" ItemsSource="{x:Bind ViewModel.TransactionTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTransactionType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingTransactionTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="手数料" />
                    <TextBox Header="貸主手数料" InputScope="Number" Text="{x:Bind ViewModel.LessorCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="貸主手数料の単位" ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLessorCommissionUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="借主手数料" InputScope="Number" Text="{x:Bind ViewModel.LesseeCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="借主手数料の単位" ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLesseeCommissionUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="元付手数料" InputScope="Number" Text="{x:Bind ViewModel.ListingBrokerCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="元付手数料の単位" ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedListingBrokerCommissionUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBox Header="客付け手数料" InputScope="Number" Text="{x:Bind ViewModel.TenantBrokerCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="客付け手数料の単位" ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTenantBrokerCommissionUnit, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <TextBox Header="備考" Text="{x:Bind ViewModel.TransactionRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
