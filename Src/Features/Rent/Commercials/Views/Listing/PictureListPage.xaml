<Page x:Class="ZumenSearch.Views.Rent.Commercials.Listing.PictureListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:ZumenSearch.Models.Rent.Commercials.Listing" NavigationCacheMode="Required" IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}">
    <Grid Padding="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Right">
            <AppBarButton Icon="Add" Label="追加" Click="AppBarButtonAddPicture_Click"/>
            <AppBarButton Icon="More" Label="その他">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="保存場所を開く" Icon="OpenLocal" Command="{x:Bind ViewModel.OpenBlobDirectoryCommand, Mode=OneWay}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="すべて削除" Icon="Delete"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pictures, Mode=OneWay}" MinWidth="300" MinHeight="225" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:ListingPicture">
                        <Border Style="{StaticResource RoundCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Image Source="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280" MaxWidth="280" MaxHeight="190" MinHeight="190"/>
                                    <StackPanel Orientation="Vertical" Height="60" VerticalAlignment="Bottom" Padding="12" Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}" Opacity=".75">
                                        <TextBlock Text="{x:Bind PictureType.Label, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="12" Margin="24,0,6,6" MinWidth="260">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Header="タイプ" PlaceholderText="選択" Width="200" ItemsSource="{x:Bind ListingPictureTypes, Mode=OneWay}" SelectedItem="{x:Bind PictureType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ListingPictureTypeLabel">
                                                    <TextBlock Text="{x:Bind Label}" Margin="0,0,5,0"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Content="メインの写真" Margin="12,0,0,0" VerticalAlignment="Bottom" IsChecked="{x:Bind IsMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <TextBox Header="説明" Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                                        <AppBarButton Icon="Delete" Label="削除" ToolTipService.ToolTip="写真を削除" Command="{x:Bind ParentViewModel.DeleteRoomPictureCommand, Mode=OneWay}" CommandParameter="{x:Bind}"/>
                                    </CommandBar>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="12"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
