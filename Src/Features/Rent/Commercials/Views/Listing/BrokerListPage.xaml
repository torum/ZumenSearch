<Page x:Class="ZumenSearch.Views.Rent.Commercials.Listing.BrokerListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:ZumenSearch.Models.Rent.Commercials" NavigationCacheMode="Required" IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}">
    <Grid Padding="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Right">
            <AppBarButton Icon="AddFriend" Label="追加" Command="{x:Bind ViewModel.AddBrokerCommand, Mode=OneWay}"/>
        </CommandBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.BrokersWrapper, Mode=OneWay}" MinWidth="300" MinHeight="225" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:PersonWrapperForListingViewModel">
                        <Border Style="{StaticResource RoundCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="会社名" IsReadOnly="True" Text="{x:Bind Person.Name, Mode=OneWay}"/>
                                <CommandBar Grid.Column="1" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                                    <AppBarButton Icon="Edit" Label="編集" ToolTipService.ToolTip="宅建業者を編集" Command="{x:Bind ParentViewModel.EditBrokerCommand, Mode=OneWay}" CommandParameter="{x:Bind}"/>
                                    <AppBarButton Icon="Delete" Label="削除" ToolTipService.ToolTip="宅建業者との関連付けを削除" Command="{x:Bind ParentViewModel.DeleteBrokerCommand, Mode=OneWay}" CommandParameter="{x:Bind}"/>
                                </CommandBar>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="12"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
