<Page x:Class="ZumenSearch.Views.Rent.Commercials.Listing.BasicPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:listing="using:ZumenSearch.Models.Rent.Commercials.Listing" mc:Ignorable="d" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,36,24">
        <StackPanel Spacing="12" Margin="0,24,0,0">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <TextBox Header="区画名" PlaceholderText="必須" MaxLength="100" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{x:Bind ViewModel.IsNameHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}" />
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox Header="所在階" ItemsSource="{x:Bind ViewModel.FloorGroundTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFloorGroundType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingFloorGroundTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Header="階数" InputScope="Number" Text="{x:Bind ViewModel.FloorNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="専有面積（平米）" InputScope="Number" Text="{x:Bind ViewModel.FloorArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox Header="用途" ItemsSource="{x:Bind ViewModel.UseTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedUseType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingUseTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Header="用途の詳細" Text="{x:Bind ViewModel.UseDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox Header="現況" ItemsSource="{x:Bind ViewModel.AvailabilityStatusTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityStatusType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingAvailabilityStatusTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="募集中" IsChecked="{x:Bind ViewModel.IsAvailableForRentNow, Mode=TwoWay}" />
                    <ComboBox Header="入居可能月" ItemsSource="{x:Bind ViewModel.AvailabilityMonthTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityMonthType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingAvailabilityMonthTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Header="入居可能時期" ItemsSource="{x:Bind ViewModel.AvailabilityPeriodTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityPeriodType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="listing:ListingAvailabilityPeriodTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="即入居可" IsChecked="{x:Bind ViewModel.IsAvailableForImmediateMoveIn, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <TextBox Header="備考" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
    

