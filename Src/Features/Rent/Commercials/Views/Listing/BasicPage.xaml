<Page
    x:Class="ZumenSearch.Views.Rent.Commercials.Listing.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mod="using:ZumenSearch.Models" 
    NavigationCacheMode="Required">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="36,0,36,24">

        <StackPanel Spacing="12" Margin="0,24,0,0">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <TextBox
                    Header="区画名"
                    PlaceholderText="必須"
                    MaxLength="100"
                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="賃料"
                        InputScope="Number"
                        Text="{x:Bind ViewModel.Chinryou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Grid.Column="1"
                        Header="共益費"
                        InputScope="Number"
                        Text="{x:Bind ViewModel.KyouekiFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="面積"
                        InputScope="Number"
                        Text="" />

                    <TextBox
                        Grid.Column="1"
                        Header="用途"
                        Text="" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <TextBox
                    Header="備考"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="120"
                    Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
    

