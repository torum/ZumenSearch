<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Listing.AppliancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <controls:WrapPanel VerticalSpacing="12" HorizontalSpacing="6">
                        <CheckBox Width="160" Content="エアコン" IsChecked="{x:Bind ViewModel.HasAirConditioner, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="フローリング" IsChecked="{x:Bind ViewModel.HasWoodFlooring, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="モニター付きインターホン" IsChecked="{x:Bind ViewModel.HasVideoIntercom, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="追い焚き" IsChecked="{x:Bind ViewModel.HasBathReheating, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="ガスコンロ" IsChecked="{x:Bind ViewModel.HasGasStove, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="IH" IsChecked="{x:Bind ViewModel.HasInductionCooktop, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="コンロ２口以上" IsChecked="{x:Bind ViewModel.HasMultipleBurners, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="システムキッチン" IsChecked="{x:Bind ViewModel.HasSystemKitchen, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="ロフト" IsChecked="{x:Bind ViewModel.HasLoft, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="室内洗濯機置き場" IsChecked="{x:Bind ViewModel.HasIndoorWashingMachineSpace, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="浴室乾燥機" IsChecked="{x:Bind ViewModel.HasBathroomDryer, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="バストイレ別" IsChecked="{x:Bind ViewModel.HasSeparateBathAndToilet, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="独立洗面台" IsChecked="{x:Bind ViewModel.HasSeparateWashbasin, Mode=TwoWay}" />
                        <CheckBox Width="160" Content="温水洗浄便座" IsChecked="{x:Bind ViewModel.HasWarmWaterToiletSeat, Mode=TwoWay}" />
                    </controls:WrapPanel>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" Text="{x:Bind ViewModel.ApplianceRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Top" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
