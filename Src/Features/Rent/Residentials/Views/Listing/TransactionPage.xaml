<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Listing.TransactionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modresidential="using:ZumenSearch.Models.Rent.Residentials"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <ComboBox Header="物件の取扱区分" Width="180" ItemsSource="{x:Bind ViewModel.HandlingTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedHandlingType, Mode=TwoWay}" Margin="0,0,0,0" VerticalAlignment="Bottom">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="modresidential:ListingHandlingTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ComboBox Header="取引態様" Width="180" ItemsSource="{x:Bind ViewModel.TransactionTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTransactionType, Mode=TwoWay}" Margin="0,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="modresidential:ListingTransactionTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">

                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <StackPanel>

                        <TextBlock Text="手数料" Margin="0"></TextBlock>
                        <StackPanel Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="貸主"/>
                                    <StackPanel Orientation="Horizontal" Margin="0 6 12 0">
                                        <TextBox Text="{x:Bind ViewModel.LessorCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0 0 3 6" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBox>
                                        <ComboBox ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLessorCommissionUnit, Mode=TwoWay}" Margin="0 0 3 6" VerticalAlignment="Bottom">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="modresidential:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="借主"/>
                                    <StackPanel Orientation="Horizontal" Margin="0 6 12 0">
                                        <TextBox Text="{x:Bind ViewModel.LesseeCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0 0 3 6" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBox>
                                        <ComboBox ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLesseeCommissionUnit, Mode=TwoWay}" Margin="0 0 3 6" VerticalAlignment="Bottom">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="modresidential:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="元付"/>
                                    <StackPanel Orientation="Horizontal" Margin="0 6 12 0">
                                        <TextBox Text="{x:Bind ViewModel.ListingBrokerCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0 0 3 6" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBox>
                                        <ComboBox ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedListingBrokerCommissionUnit, Mode=TwoWay}" Margin="0 0 3 6" VerticalAlignment="Bottom">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="modresidential:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="客付け"/>
                                    <StackPanel Orientation="Horizontal" Margin="0 6 12 0">
                                        <TextBox Text="{x:Bind ViewModel.TenantBrokerCommission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0 0 3 6" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBox>
                                        <ComboBox ItemsSource="{x:Bind ViewModel.CommissionUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTenantBrokerCommissionUnit, Mode=TwoWay}" Margin="0 0 3 6" VerticalAlignment="Bottom">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="modresidential:ListingCommissionUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" Text="{x:Bind ViewModel.TransactionRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Top" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
    
</Page>
