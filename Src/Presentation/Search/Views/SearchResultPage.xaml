<Page
    x:Class="ZumenSearch.Presentation.Search.Views.SearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ZumenSearch.Presentation.Search.Views"
    xmlns:mod="using:ZumenSearch.Presentation.Shell.Models"
    xmlns:searchresultviewmodel="using:ZumenSearch.Presentation.Search.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <Page.Resources>
        <!-- DataTemplate for Rent Residential -->
        <DataTemplate x:Key="RentResidentialTemplate" x:DataType="searchresultviewmodel:PropertySearchResultItemViewModel">
            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="SearchResult_DoubleTapped" PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                <ItemContainer.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                </ItemContainer.KeyboardAccelerators>
                <Border CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0">
                    <Grid Height="{StaticResource SearchThumbnailHeight}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource SearchThumbnailColumnWidth}"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Background="{ThemeResource AcrylicInAppFillColorBaseBrush}">
                            <TextBlock Text="画像・図面登録なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle RadiusX="3" RadiusY="3" Width="{StaticResource SearchThumbnailWidth}" Height="{StaticResource SearchThumbnailHeight}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock Text="賃貸住居用" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1" Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="6">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="最終更新日時:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="追加日時:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind CreatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <!-- DataTemplate for Rent Commercial -->
        <DataTemplate x:Key="RentCommercialTemplate" x:DataType="searchresultviewmodel:PropertySearchResultItemViewModel">
            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="SearchResult_DoubleTapped" PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                <ItemContainer.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                </ItemContainer.KeyboardAccelerators>
                <Border CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0">
                    <Grid Height="{StaticResource SearchThumbnailHeight}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource SearchThumbnailColumnWidth}"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Background="{ThemeResource AcrylicInAppFillColorBaseBrush}">
                            <TextBlock Text="画像・図面登録なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle RadiusX="3" RadiusY="3" Width="{StaticResource SearchThumbnailWidth}" Height="{StaticResource SearchThumbnailHeight}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock Text="賃貸事業用" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1" Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="6">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="最終更新日時:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="追加日時:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind CreatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <!-- DataTemplate for Sale Residential -->
        <DataTemplate x:Key="SaleResidentialTemplate" x:DataType="searchresultviewmodel:PropertySearchResultItemViewModel">
            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="SearchResult_DoubleTapped" PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                <ItemContainer.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                </ItemContainer.KeyboardAccelerators>
                <Grid Height="{StaticResource SearchThumbnailHeight}">
                    <TextBlock Text="画像・図面登録なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="売買住居用" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Border VerticalAlignment="Bottom" Padding="10,8" CornerRadius="0,0,3,3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="更新:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        <!-- Instantiate the Selector and reference our DataTemplates -->
        <local:PropertyTypeTemplateSelector x:Key="PropertyTypeTemplateSelector"
            RentResidentialTemplate="{StaticResource RentResidentialTemplate}"
            RentCommercialTemplate="{StaticResource RentCommercialTemplate}"
            SaleResidentialTemplate="{StaticResource SaleResidentialTemplate}"/>

    </Page.Resources>
    <Grid x:Name="ContentArea" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="{StaticResource ContentPadding}">
            <Grid Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <BreadcrumbBar x:Name="BreadcrumbBar1" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind ViewModel.BreadcrumbItemsRentSearchResult, Mode=OneWay}" VerticalAlignment="Center">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="mod:Breadcrumb">
                            <BreadcrumbBarItem>
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate x:DataType="mod:Breadcrumb">
                                        <TextBlock Text="{x:Bind Name}" FontSize="28" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,3,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <AppBarButton Icon="Back" Label="戻る" Command="{x:Bind ViewModel.GoBackCommand}"/>
                        <AppBarButton Icon="Add" Label="新規">
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="賃貸：住居用" Command="{x:Bind ViewModel.AddNewRentResidentialCommand}"/>
                                    <MenuFlyoutItem Text="賃貸：事業用" Command="{x:Bind ViewModel.AddNewRentCommercialCommand}"/>
                                    <MenuFlyoutItem Text="賃貸：駐車場"/>
                                    <MenuFlyoutItem Text="貸主" Command="{x:Bind ViewModel.AddNewRentLessorCommand}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="宅建業者" Command="{x:Bind ViewModel.AddNewBrokerCommand}"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="{StaticResource ContentPadding}">

                <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,24,0" HorizontalAlignment="Right">
                    <AppBarButton Icon="Delete" Label="削除" Command="{x:Bind ViewModel.DeletePropertyCommand}" CommandParameter="{x:Bind SearchResultListView.SelectedItem, Mode=OneWay}"/>
                    <AppBarButton Icon="Sort" IsCompact="True" ToolTipService.ToolTip="Sort" Label="並べ替え">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="物件名" Tag="name"/>
                                <MenuFlyoutItem Text="物件種別" Tag="type"/>
                                <MenuFlyoutItem Text="更新日" Tag="updated"/>
                                <MenuFlyoutItem Text="作成日" Tag="created"/>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="順序" Tag="order">
                                    <MenuFlyoutItem Text="昇順" Tag="asc" />
                                    <MenuFlyoutItem Text="降順" Tag="desc" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Icon="Copy" Label="複製" Command="{x:Bind ViewModel.DuplicatePropertyCommand}" CommandParameter="{x:Bind SearchResultListView.SelectedItem, Mode=OneWay}"/>
                    <AppBarButton Icon="Edit" Label="編集" Command="{x:Bind ViewModel.EditPropertyCommand}" CommandParameter="{x:Bind SearchResultListView.SelectedItem, Mode=OneWay}"/>
                </CommandBar>

                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}"></Border>

            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="{StaticResource ContentPadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsView x:Name="SearchResultListView" Margin="0,12,0,0" ItemTemplate="{StaticResource PropertyTypeTemplateSelector}" ItemsSource="{x:Bind ViewModel.PropertySearchResult, Mode=OneWay}" AllowFocusOnInteraction="True" SelectionMode="Single">
                    <ItemsView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="編集" Icon="Edit" Command="{x:Bind ViewModel.EditPropertyCommand}" CommandParameter="{x:Bind SearchResultListView.SelectedItem, Mode=OneWay}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="複製" Icon="Copy" Command="{x:Bind ViewModel.DuplicatePropertyCommand}" CommandParameter="{x:Bind SearchResultListView.SelectedItem, Mode=OneWay}"></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="削除" Icon="Delete" Command="{x:Bind ViewModel.DeletePropertyCommand}" CommandParameter="{x:Bind SearchResultListView.SelectedItem, Mode=OneWay}"></MenuFlyoutItem>
                        </MenuFlyout>
                    </ItemsView.ContextFlyout>
                    <!--
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="modcommon:PropertySearchResultItem">
                            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="SearchResult_DoubleTapped" PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                                <ItemContainer.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                                </ItemContainer.KeyboardAccelerators>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Ellipse" Grid.RowSpan="2" Width ="32" Height="32" Margin="6" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{ThemeResource SystemControlBackgroundBaseMediumBrush}"/>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,6,0,0">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{ThemeResource BaseTextBlockStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Id, Mode=OneTime}" x:Phase="2" Style="{ThemeResource BodyTextBlockStyle}" Margin="12,0,0,6"/>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
-->
                    <ItemsView.Layout>
                        <StackLayout Spacing="12"></StackLayout>
                        <!--
                        <UniformGridLayout MaximumRowsOrColumns="10" 
                           MinRowSpacing="6" 
                           MinColumnSpacing="6"/>
                        -->
                    </ItemsView.Layout>
                </ItemsView>

            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
