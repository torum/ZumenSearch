<Page
    x:Class="ZumenSearch.Presentation.Features.Rent.Residentials.Views.Listing.PictureListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="using:ZumenSearch.Presentation.Shell.Models"
    xmlns:modresidentials="using:ZumenSearch.Presentation.Features.Rent.Residentials.Models"
    xmlns:viewmodels="using:ZumenSearch.Presentation.Features.Rent.Residentials.ViewModels"
    xmlns:local="using:ZumenSearch.Presentation.Features.Rent.Residentials.Views.Listing"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentArea" Padding="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,0,0" HorizontalAlignment="Right">
                <AppBarButton Name="AppBarButtonAddPicture" Icon="Add" Label="追加" Click="AppBarButtonAddPicture_Click"/>
                <AppBarButton Icon="More" Label="その他">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="保存場所を開く" Icon="OpenLocal" Command="{x:Bind ViewModel.OpenBlobDirectoryCommand, Mode=OneWay}"></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="すべて削除" Icon="Delete" Command="{x:Bind ViewModel.ListingPictureDeleteAllCommand, Mode=OneWay}"></MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollMode="Disabled">
                <ItemsRepeater x:Name="ItemsView" ItemsSource="{x:Bind ViewModel.Pictures, Mode=TwoWay}" MinWidth="300" MinHeight="225" ScrollViewer.HorizontalScrollMode="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <!--  SelectionChanged="ItemsView_SelectionChanged" SelectionMode="Single" IsItemInvokedEnabled="False"  -->
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ListingPictureViewModel">
                            <Border Style="{StaticResource RoundCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource DetailThumbnailColumnWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
                                        <Rectangle RadiusX="3" RadiusY="3" Width="{StaticResource DetailThumbnailWidth}" Height="{StaticResource DetailThumbnailHeight}">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
<!--                                        
                                        <Image Source="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="{StaticResource DetailThumbnailWidth}" MaxWidth="{StaticResource DetailThumbnailWidth}" MaxHeight="{StaticResource DetailThumbnailHeight}" MinHeight="{StaticResource DetailThumbnailHeight}"/>
-->
                                        <StackPanel Orientation="Vertical" Height="50" VerticalAlignment="Bottom" Padding="6" Margin="0,0,0,0" CornerRadius="0,0,4,4" Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}" Opacity=".75">
                                            <TextBlock Text="{x:Bind PictureType.Label, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <StackPanel Spacing="12" Margin="24,0,6,0" MinWidth="260">
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox x:Name="ComboBoxKinds" Header="タイプ" PlaceholderText="選択" Width="200" ItemsSource="{x:Bind ListingPictureTypes, Mode=OneWay}" SelectedItem="{x:Bind PictureType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="modresidentials:ListingPictureTypeLabel">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{x:Bind Label}" Margin="0,0,5,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <CheckBox Content="メインの写真" Margin="12,0,0,0" VerticalAlignment="Bottom" IsChecked="{x:Bind IsMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                                            </StackPanel>
                                            <TextBox Header="説明" Margin="0,0,0,0" Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                                            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,0,0" HorizontalAlignment="Right">
                                                <AppBarButton Icon="OpenFile" Label="開く" ToolTipService.ToolTip="写真を開く" Command="{x:Bind ParentViewModel.OpenListingPictureCommand, Mode=OneWay}" CommandParameter="{x:Bind}" />
                                                <AppBarButton Icon="Delete" Label="削除" ToolTipService.ToolTip="写真を削除" Command="{x:Bind ParentViewModel.DeleteListingPictureCommand, Mode=OneWay}" CommandParameter="{x:Bind}"/>
                                            </CommandBar>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12" />
                        <!--
                        <UniformGridLayout MinRowSpacing="18" MinColumnSpacing="18" ItemsJustification="SpaceEvenly"/>
                        -->
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
