<Page x:Class="ZumenSearch.Presentation.Features.Rent.Commercials.Views.Listing.BasicPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:listing="using:ZumenSearch.Presentation.Features.Rent.Commercials.Models" mc:Ignorable="d" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">
                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel>
                                <TextBox x:Name="TextBoxName" TabIndex="0" MinWidth="200" Header="区画名" PlaceholderText="必須" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{x:Bind ViewModel.IsNameHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="専有面積（平米）" Text="{x:Bind ViewModel.FloorArea, Mode=TwoWay}" MinWidth="120" Width="120" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                                    <ComboBox Header="所在階" ItemsSource="{x:Bind ViewModel.FloorGroundTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFloorGroundType, Mode=TwoWay}" Margin="6,0,0,0" MinWidth="90" Width="90" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="listing:ListingFloorGroundTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Text="{x:Bind ViewModel.FloorNumber, Mode=TwoWay}" Width="60" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320" />
                            <ColumnDefinition Width="1*" MinWidth="320" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Header="用途" ItemsSource="{x:Bind ViewModel.UseTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedUseType, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="listing:ListingUseTypeLabel">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Header="用途の詳細" Text="{x:Bind ViewModel.UseDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ComboBox Header="現況" Width="170" ItemsSource="{x:Bind ViewModel.CurrentStatusTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCurrentStatusType, Mode=TwoWay}" Margin="0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingAvailabilityStatusTypeLabel">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <CheckBox Content="募集中" Margin="12,0,0,0" IsChecked="{x:Bind ViewModel.IsAvailableForRentNow, Mode=TwoWay}" VerticalAlignment="Bottom"></CheckBox>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <CalendarDatePicker x:Name="CurrentStatusDatePicker" Header="現況確認日" Date="{x:Bind ViewModel.OccupancyStatusCheckedAt, Mode=TwoWay}" Margin="0" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Button Content="本日確認" Margin="6,0,0,0" Padding="6" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ComboBox Header="入居可能日" ItemsSource="{x:Bind ViewModel.AvailabilityMonthTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityMonthType, Mode=TwoWay}" Width="100" Margin="0" VerticalAlignment="Bottom">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="listing:ListingAvailabilityMonthTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailabilityPeriodTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityPeriodType, Mode=TwoWay}" Width="90" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="listing:ListingAvailabilityPeriodTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <CheckBox Content="即入居可" Margin="12,0,0,0" IsChecked="{x:Bind ViewModel.IsAvailableForImmediateMoveIn, Mode=TwoWay}" VerticalAlignment="Bottom"></CheckBox>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320" />
                            <ColumnDefinition Width="1*" MinWidth="320" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBox Header="不動産番号" IsReadOnly="True" IsEnabled="False" MaxLength="13" InputScope="Number" Text="{x:Bind ViewModel.FudousanId, Mode=OneWay}"></TextBox>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Header="特定コード" PlaceholderText="4桁の半角英数字（英字は大文字）" MaxLength="4" Text="{x:Bind ViewModel.FudousanIdAdditionalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" Text="{x:Bind ViewModel.Remarks, Mode=TwoWay}" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Top" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
    

