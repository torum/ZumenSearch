<Page x:Class="ZumenSearch.Presentation.Features.Rent.Commercials.Views.Listing.ContractPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:listing="using:ZumenSearch.Presentation.Features.Rent.Commercials.Models" mc:Ignorable="d" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">
                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBox Header="賃料（月額・円）" Text="{x:Bind ViewModel.Chinryou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Header="共益費・管理費（月額・円）" Text="{x:Bind ViewModel.ManagementFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <ComboBox Header="賃料の消費税" ItemsSource="{x:Bind ViewModel.ContractTaxTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRentTax, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="listing:ListingContractTaxTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="12,12,0,0">
                            <ComboBox Header="共益費・管理費の消費税" ItemsSource="{x:Bind ViewModel.ContractTaxTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedManagementFeeTax, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="listing:ListingContractTaxTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox MinWidth="200" Header="敷金" Text="{x:Bind ViewModel.SecurityDeposit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <ComboBox AutomationProperties.Name="敷金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSecurityDepositUnit, Mode=TwoWay}" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox MinWidth="200" Header="礼金" Text="{x:Bind ViewModel.KeyMoney, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <ComboBox AutomationProperties.Name="礼金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKeyMoneyUnit, Mode=TwoWay}" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox MinWidth="200" Header="保証金" InputScope="Number" Text="{x:Bind ViewModel.GuaranteeDeposit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <ComboBox AutomationProperties.Name="保証金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGuaranteeDepositUnit, Mode=TwoWay}" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="12,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox MinWidth="200" Header="権利金" InputScope="Number" Text="{x:Bind ViewModel.RightsMoney, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <ComboBox AutomationProperties.Name="権利金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRightsMoneyUnit, Mode=TwoWay}" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox MinWidth="200" Header="敷引・償却金" InputScope="Number" Text="{x:Bind ViewModel.DepositDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <ComboBox AutomationProperties.Name="敷引・償却金の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDepositDeductionUnit, Mode=TwoWay}" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Header="更新料" Text="{x:Bind ViewModel.RenewalFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <ComboBox AutomationProperties.Name="更新料の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRenewalFeeUnit, Mode=TwoWay}" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Header="再契約手数料" Text="{x:Bind ViewModel.RecontractFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <ComboBox AutomationProperties.Name="再契約手数料の単位" ItemsSource="{x:Bind ViewModel.FeeUnitTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRecontractFeeUnit, Mode=TwoWay}" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingFeeUnitTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="12,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Header="契約種別" ItemsSource="{x:Bind ViewModel.ContractTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedContractType, Mode=TwoWay}" Width="200" Margin="0,0,0,0" VerticalAlignment="Bottom">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="listing:ListingContractTypeLabel"><TextBlock Text="{x:Bind Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Header="契約期間（年）" Text="{x:Bind ViewModel.ContractPeriodYears, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBox Header="保証会社" Text="{x:Bind ViewModel.GuarantorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Header="保険" Text="{x:Bind ViewModel.Insurance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <TextBox Header="その他" Text="{x:Bind ViewModel.OtherFees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                </Border>

                <Expander Header="その他条件" Margin="0" Padding="24" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox Header="その他" Text="{x:Bind ViewModel.ContractConditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                </Expander>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" Text="{x:Bind ViewModel.ContractRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Top" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
