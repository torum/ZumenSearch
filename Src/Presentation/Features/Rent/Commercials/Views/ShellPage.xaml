<Page
    x:Class="ZumenSearch.Presentation.Features.Rent.Commercials.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    xmlns:helpers="using:ZumenSearch.Presentation.Helpers"
    xmlns:mod="using:ZumenSearch.Presentation.Shell.Models"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">
    <!--
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="KeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" MaxHeight="120"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="AppTitleBar" Margin="0,0,0,0" Canvas.ZIndex="1" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon" Grid.Row="0" Grid.Column="0" Source="/Assets/App.ico" HorizontalAlignment="Left" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"/>

            <TextBlock x:Name="AppTitleBarText" Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" VerticalAlignment="Center"/>

        </Grid>

        <InfoBar Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsInfoBarErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.InfoBarErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="2" Margin="36,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <BreadcrumbBar
                Grid.Column="0" x:Name="BreadcrumbBar1"
                ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}"
                IsHitTestVisible="False" AllowFocusOnInteraction="False" IsTabStop="False" VerticalAlignment="Center">

                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="mod:Breadcrumb">
                        <BreadcrumbBarItem>
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate x:DataType="mod:Breadcrumb">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontSize="28"
                                        FontWeight="SemiBold" />
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>

            <AppBarButton
                Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                Icon="Save"
                Label="保存"
                ToolTipService.ToolTip="保存（Ctrl+S）"
                Command="{x:Bind ViewModel.SaveCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <NavigationView x:Name="NavView" Grid.Row="0" Margin="36,3,36,0" PaneDisplayMode="Top" IsTitleBarAutoPaddingEnabled="True" SelectionFollowsFocus="Disabled" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}" Loaded="NavView_Loaded" ItemInvoked="NavView_ItemInvoked" BackRequested="NavView_BackRequested">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="基本"
                        Tag="rent.commercial.property.basic" />
                    <NavigationViewItem
    Content="所在地"
    Tag="rent.commercial.property.location" />
                    <NavigationViewItem
    Content="交通"
    Tag="rent.commercial.property.transportation" />
                    <NavigationViewItem
    Content="設備"
    Tag="rent.commercial.property.facilities" />
                    <NavigationViewItem
    Content="管理"
    Tag="rent.commercial.property.management" />
                    <NavigationViewItem
    Content="写真"
    Tag="rent.commercial.property.pictures" />
                    <NavigationViewItem Content="図面" Tag="rent.commercial.property.documents" Visibility="{x:Bind ViewModel.IsUnitOwnershipVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <NavigationViewItem Content="貸主" Tag="rent.commercial.property.lessors" Visibility="{x:Bind ViewModel.IsUnitOwnershipVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    <NavigationViewItem Content="宅建業者" Tag="rent.commercial.property.brokers" Visibility="{x:Bind ViewModel.IsUnitOwnershipVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="募集物件" Tag="rent.commercial.property.listings" />
                </NavigationView.FooterMenuItems>
            </NavigationView>

            <Frame x:Name="ContentFrame" Grid.Row="1" NavigationFailed="ContentFrame_NavigationFailed" Navigated="ContentFrame_Navigated" />
            <!--  IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}" -->
        </Grid>
    </Grid>

</Page>
