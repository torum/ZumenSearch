<Page x:Class="ZumenSearch.Presentation.Features.Rent.Commercials.Views.ZumenListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:modcommercials="using:ZumenSearch.Presentation.Features.Rent.Commercials.Models" xmlns:entities="using:ZumenSearch.Domain.Entities.Rent.Commercials" xmlns:media="using:ZumenSearch.Presentation.Features.Rent.Commercials.ViewModels" mc:Ignorable="d" NavigationCacheMode="Required">

    <Grid x:Name="ContentArea" Padding="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,0,0" HorizontalAlignment="Right">
                <AppBarButton Name="AppBarButtonAddPdf" Icon="Add" Label="追加" Click="AppBarButtonAddPdf_Click"/>
                <AppBarButton Icon="More" Label="その他">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="保存場所を開く" Icon="OpenLocal" Command="{x:Bind ViewModel.OpenPropertyBlobDirectoryCommand, Mode=OneWay}"></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="すべて削除" Icon="Delete" Command="{x:Bind ViewModel.PropertyPdfDeleteAllCommand, Mode=OneWay}"></MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollMode="Disabled">
                <ItemsRepeater x:Name="ItemsView" ItemsSource="{x:Bind ViewModel.Pdfs, Mode=TwoWay}" ScrollViewer.HorizontalScrollMode="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <!--  SelectionChanged="ItemsView_SelectionChanged" SelectionMode="Single" IsItemInvokedEnabled="False"  -->
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="media:PropertyPdfViewModel">
                            <Border Style="{StaticResource RoundCardBorderStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource DetailThumbnailColumnWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox MaxWidth="{StaticResource DetailThumbnailWidth}" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" StretchDirection="DownOnly">
                                        <Grid Width="{StaticResource DetailThumbnailWidth}" Height="{StaticResource DetailThumbnailHeight}">
                                            <Rectangle RadiusX="3" RadiusY="3">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{x:Bind ThumbImagePath, Converter={StaticResource ImagePathToImageSourceConverter}, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <StackPanel VerticalAlignment="Bottom" Padding="8,6" CornerRadius="0,0,4,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind PdfType.Label, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboBoxKinds" Header="タイプ" PlaceholderText="選択" Width="200" HorizontalAlignment="Left" ItemsSource="{x:Bind CommercialPdfTypes, Mode=OneWay}" SelectedItem="{x:Bind PdfType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="modcommercials:PropertyPdfTypeLabel">
                                                        <TextBlock Text="{x:Bind Label}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <CheckBox Grid.Column="1" Content="メインの図面" VerticalAlignment="Bottom" IsChecked="{x:Bind IsMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <TextBox Header="説明" Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                        <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                                            <AppBarButton Icon="OpenFile" Label="開く" ToolTipService.ToolTip="PDFを開く" Command="{x:Bind ParentViewModel.OpenPropertyPdfCommand, Mode=OneWay}" CommandParameter="{x:Bind}" />
                                            <AppBarButton Icon="Delete" Label="削除" ToolTipService.ToolTip="PDFを削除" Command="{x:Bind ParentViewModel.DeletePropertyPdfCommand, Mode=OneWay}" CommandParameter="{x:Bind}"/>
                                        </CommandBar>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12" />
                        <!--
                        <UniformGridLayout MinRowSpacing="18" MinColumnSpacing="18" ItemsJustification="SpaceEvenly"/>
                        -->
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
