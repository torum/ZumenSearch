<Page
    x:Class="ZumenSearch.Presentation.Features.Brokers.Views.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:framework="using:Microsoft.UI.Xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mod="using:ZumenSearch.Presentation.Shell.Models"
    xmlns:modbroker="using:ZumenSearch.Presentation.Features.Brokers.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <controls:Segmented x:Name="SegmentedControl" HorizontalAlignment="Center" SelectedIndex="{x:Bind ViewModel.PersonKindIndex, Mode=TwoWay}">
                    <controls:SegmentedItem Content="個人" Tag="one" />
                    <controls:SegmentedItem Content="法人" Tag="two" />
                </controls:Segmented>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <controls:SwitchPresenter Value="{x:Bind ((framework:FrameworkElement)SegmentedControl.SelectedItem).Tag, Mode=OneWay}">
                        <controls:Case Value="one">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                                    <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TextBox_NameLast" Grid.Column="0" TabIndex="0" MinWidth="200" Header="姓" PlaceholderText="必須" MaxLength="100" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.NameLast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{x:Bind ViewModel.IsNameLastHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                                <TextBox Grid.Column="1" Margin="12,0,0,0" TabIndex="0" MinWidth="200" Header="名" MaxLength="100" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.NameFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                            </Grid>
                        </controls:Case>
                        <controls:Case Value="two">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                                    <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TextBox_NameCompany" Grid.Column="0" TabIndex="0" MinWidth="200" Header="会社名" PlaceholderText="必須" MaxLength="100" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.NameCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{x:Bind ViewModel.IsNameCompanyHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                                    <TextBox x:Name="TextBox_NameCompanyType" TabIndex="0" MinWidth="150" Header="法人格" PlaceholderText="株式会社等" MaxLength="100" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.NameCompanyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                                    <ComboBox x:Name="ComboBoxCompanyTypes" Header="法人格の位置" PlaceholderText="選択" Width="120" Margin="6,0,0,0" SelectedIndex="{x:Bind ViewModel.NameCompanyTypePosition, Mode=TwoWay}" VerticalAlignment="Bottom">
                                        <x:String>前付け</x:String>
                                        <x:String>後付け</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </controls:Case>
                    </controls:SwitchPresenter>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="固定電話番号" MaxLength="30" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                        <controls:SwitchPresenter Grid.Column="1" Margin="12,0,0,0" Value="{x:Bind ((framework:FrameworkElement)SegmentedControl.SelectedItem).Tag, Mode=OneWay}">
                            <controls:Case Value="one">
                                <TextBox Header="携帯電話番号" MaxLength="30" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.MobilePhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                            </controls:Case>
                            <controls:Case Value="two">
                                <TextBox Header="担当者名" MaxLength="100" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.ContactName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                            </controls:Case>
                        </controls:SwitchPresenter>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="郵便番号" Width="160" MaxLength="8" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1" Header="住所・所在地" MaxLength="500" Paste="TextBox_MaxLength_Paste" Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <TextBox Header="備考" MaxLength="10000" Paste="TextBox_MaxLength_Paste"
                              Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" IsSpellCheckEnabled="False"
                             MinWidth="400" MinHeight="160" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
                
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
