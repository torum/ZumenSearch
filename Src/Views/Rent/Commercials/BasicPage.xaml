<Page
    x:Class="ZumenSearch.Views.Rent.Commercials.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modcom="using:ZumenSearch.Models.Rent.Commercials"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        Padding="36,0,36,24">

        <StackPanel Spacing="12" Margin="0,24,0,0">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="物件名"
                        PlaceholderText="必須"
                        MaxLength="100"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        Grid.Column="1"
                        Header="事業用種目"
                        PlaceholderText="選択"
                        ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="modcom:Kind">
                                <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox
                        Grid.Column="2"
                        Content="区分所有"
                        VerticalAlignment="Bottom"
                        IsChecked="{x:Bind ViewModel.IsUnitOwnership, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        Header="建物構造"
                        PlaceholderText="選択"
                        ItemsSource="{x:Bind ViewModel.Structures, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedStructure, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="modcom:Structure">
                                <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Grid.Column="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Header="地上階数"
                            InputScope="Number"
                            Text="{x:Bind ViewModel.FloorCountAboveGround, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Grid.Column="1"
                            Header="地下階数"
                            InputScope="Number"
                            Text="{x:Bind ViewModel.FloorCountBasement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Grid.Column="2"
                            Header="延床面積"
                            InputScope="Number"
                            Text="{x:Bind ViewModel.TotalFloorArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <DatePicker
                        Grid.Column="0"
                        Header="築年月"
                        DayVisible="False"
                        Language="ja-JP"
                        SelectedDate="{x:Bind ViewModel.BuiltYearAndMonth, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="不動産番号"
                        Text="{x:Bind ViewModel.FudousanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Grid.Column="1"
                        Header="不動産番号追加コード"
                        Text="{x:Bind ViewModel.FudousanIdAdditionalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <TextBox
                    Header="備考"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    IsSpellCheckEnabled="False"
                    MinHeight="160"
                    Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>