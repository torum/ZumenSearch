<Page
    x:Class="ZumenSearch.Views.Rent.Commercials.TransportationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:modcommon="using:ZumenSearch.Models.Common"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations" 
    xmlns:framework="using:Microsoft.UI.Xaml"
    NavigationCacheMode="Required">
    <Page.Resources>
        <animations:ImplicitAnimationSet x:Name="ShowTransitions">
            <animations:OffsetAnimation EasingMode="EaseOut" From="0,24,0" To="0" Duration="0:0:0.4" />
            <animations:OpacityAnimation EasingMode="EaseOut" From="0" To="1" Duration="0:0:0.2" />
        </animations:ImplicitAnimationSet>
        <animations:ImplicitAnimationSet x:Name="HideTransitions">
            <animations:OffsetAnimation EasingMode="EaseOut" From="0" To="0,24,0" Duration="0:0:0.2" />
            <animations:OpacityAnimation EasingMode="EaseOut" From="1" To="0" Duration="0:0:0.1" />
        </animations:ImplicitAnimationSet>
    </Page.Resources>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <controls:Segmented x:Name="SegmentedControl" HorizontalAlignment="Center" SelectedIndex="0">
                    <controls:SegmentedItem Content="交通１" Tag="one" />
                    <controls:SegmentedItem Content="交通２" Tag="two" />
                    <controls:SegmentedItem Content="交通３" Tag="three" />
                    <controls:SegmentedItem Content="交通４" Tag="four" />
                </controls:Segmented>

                <controls:SwitchPresenter Value="{x:Bind ((framework:FrameworkElement)SegmentedControl.SelectedItem).Tag, Mode=OneWay}">
                    <controls:Case Value="one">
                        <Border animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                            animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                            HorizontalAlignment="Stretch"  Style="{StaticResource RoundCardBorderStyle}">


                            <StackPanel Spacing="12" Margin="0,24,0,0">

                                <Border Style="{StaticResource RoundCardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock
                        Text="鉄道"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="TextBoxRailLine1"
                            Grid.Column="0"
                            Header="路線"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedRailLine1.LineName, Mode=OneWay}" />

                                            <Button
                            Grid.Column="1"
                            Content="選択"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.ShowRailLineSelect1Command}" />
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="TextBoxRailStation1"
                            Grid.Column="0"
                            Header="駅名"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedRailStation1.StationName, Mode=OneWay}" />

                                            <Button
                            Grid.Column="1"
                            Content="選択"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.ShowRailStationSelect1Command}" />
                                        </Grid>

                                        <TextBox
                        Header="駅から徒歩（分）"
                        InputScope="Number"
                        MaxLength="4"
                        Text="{x:Bind ViewModel.EkiToho1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource RoundCardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock
                        Text="バス"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />

                                        <TextBox
                        Header="バス停名"
                        Text="{x:Bind ViewModel.BusStop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox
                        Header="バス乗車時間（分）"
                        InputScope="Number"
                        MaxLength="4"
                        Text="{x:Bind ViewModel.BusJyousya1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox
                        Header="バス停から徒歩（分）"
                        InputScope="Number"
                        MaxLength="4"
                        Text="{x:Bind ViewModel.BusStopToho1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </Border>
                            
                    </controls:Case>
                    <controls:Case Value="two">
                        <Border animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                            animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                            HorizontalAlignment="Stretch"  Style="{StaticResource RoundCardBorderStyle}">

                            <TextBlock VerticalAlignment="Center"
                               Text="This is the two panel" />
                        </Border>
                    </controls:Case>
                    <controls:Case Value="three">
                        <Border animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                            animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                            HorizontalAlignment="Stretch"  Style="{StaticResource RoundCardBorderStyle}">

                            <TextBlock VerticalAlignment="Center"
                               Text="This is the three panel" />
                        </Border>
                    </controls:Case>
                    <controls:Case Value="four">
                        <Border animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                            animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                            HorizontalAlignment="Stretch"  Style="{StaticResource RoundCardBorderStyle}">

                            <TextBlock VerticalAlignment="Center"
                               Text="This is the four panel" />
                        </Border>
                    </controls:Case>
                </controls:SwitchPresenter>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

