<Page
    x:Class="ZumenSearch.Views.Rent.Commercials.UnitListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modlisting="using:ZumenSearch.Models.Rent.Commercials.Listing"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            Background="Transparent"
            IsOpen="False"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Right">
            <AppBarButton
                Icon="Add"
                Label="区画追加"
                Command="{x:Bind ViewModel.AddNewUnitCommand}"
                ToolTipService.ToolTip="区画を追加" />
        </CommandBar>

        <Border
            Grid.Row="1"
            Style="{StaticResource RoundCardBorderStyle}">
            <ItemsView
                ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                SelectionMode="None">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="modlisting:Listing">
                        <ItemContainer DataContext="{x:Bind}">
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                    Text="{x:Bind Name, Mode=OneWay}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    VerticalAlignment="Center" />

                                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind FloorArea, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0" />
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
                <ItemsView.Layout>
                    <StackLayout Spacing="8" />
                </ItemsView.Layout>
            </ItemsView>
        </Border>
    </Grid>
</Page>