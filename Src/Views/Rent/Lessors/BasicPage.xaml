<Page
    x:Class="ZumenSearch.Views.Rent.Lessors.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mod="using:ZumenSearch.Models.Common"
    xmlns:modlessor="using:ZumenSearch.Models.Rent.Lessors"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <!-- 性 -->
                            <TextBox x:Name="TextBox_NameLast" TabIndex="0" MinWidth="200" Header="姓" PlaceholderText="必須" MaxLength="100" Paste="TextBox_MaxLength_Paste"
                                         Text="{x:Bind ViewModel.NameLast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderBrush="{x:Bind ViewModel.IsNameLastHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <!-- 名 -->
                            <TextBox x:Name="TextBox_NameFist" TabIndex="0" MinWidth="200" Header="名" PlaceholderText="必須" MaxLength="100" Paste="TextBox_MaxLength_Paste"
                                         Text="{x:Bind ViewModel.NameFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderBrush="{x:Bind ViewModel.IsNameFirstHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <!--  -->

                        </Grid>
                        <!--  -->
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">

                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <!--  -->
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <!--  -->
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <TextBox Header="備考" MaxLength="10000" Paste="TextBox_MaxLength_Paste"
                              Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" IsSpellCheckEnabled="False"
                             MinWidth="400" MinHeight="160" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
                
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
