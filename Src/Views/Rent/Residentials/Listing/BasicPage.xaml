<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Listing.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mod="using:ZumenSearch.Models" 
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">

            <StackPanel Spacing="12" Margin="0,24,0,0">

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel>
                                <!--
                                <Border Visibility="{x:Bind ViewModel.NameHasError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ImageIcon x:Name="IconHostError" Source="ms-appx:///Assets/SvgIcons/ic_fluent_error_circle_16_color.svg" Width="16" Height="16" Margin="0,0,0,0"/>
                                        <TextBlock Text="{x:Bind ViewModel.NameErrorMessage, Mode=OneWay}" Margin="8,0,0,0"></TextBlock>
                                    </StackPanel>
                                </Border>
                                -->
                                <TextBox x:Name="TextBoxName" TabIndex="0" MinWidth="200" Header="部屋番号" PlaceholderText="必須" 
                                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderBrush="{x:Bind ViewModel.IsNameHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="間取り" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                         <ComboBox ItemsSource="{x:Bind ViewModel.RoomCountOptions}" SelectedItem="{x:Bind ViewModel.SelectedRoomCountOption, Mode=TwoWay}" Width="80" VerticalAlignment="Bottom" />
                                         <ComboBox ItemsSource="{x:Bind ViewModel.RoomLayoutOptions}" SelectedItem="{x:Bind ViewModel.SelectedRoomLayoutOption, Mode=TwoWay}" Margin="6,0,0,0" Width="100" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                                <TextBox Header="専有面積（平米）" Text="{x:Bind ViewModel.FloorArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0" VerticalAlignment="Bottom">
                                <ComboBox Header="所在階" ItemsSource="{x:Bind ViewModel.FloorTypeOptions}" Width="80" Margin="0" SelectedItem="{x:Bind ViewModel.SelectedFloorTypeOption, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <TextBox Text="{x:Bind ViewModel.FloorNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <CheckBox IsChecked="{x:Bind ViewModel.IsCornerRoom, Mode=TwoWay}" Margin="12,0,0,0" Content="角部屋" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ComboBox Header="主要採光面" ItemsSource="{x:Bind ViewModel.MainExposureDirectionOptions}" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" SelectedItem="{x:Bind ViewModel.SelectedExposureDirectionOption, Mode=TwoWay}" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0" VerticalAlignment="Bottom">
                                <ComboBox Header="現況" ItemsSource="{x:Bind ViewModel.CurrentStatusOptions}" Width="224" Margin="0" SelectedItem="{x:Bind ViewModel.SelectedCurrentStatusOption, Mode=TwoWay}" />
                                <CheckBox IsChecked="{x:Bind ViewModel.IsRecruiting, Mode=TwoWay}" Content="募集中" Margin="12,0,0,0" VerticalAlignment="Bottom"></CheckBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Header="入居可能日" ItemsSource="{x:Bind ViewModel.AvailableFromMonthOptions}" Width="100" SelectedItem="{x:Bind ViewModel.SelectedAvailableFromMonthOption, Mode=TwoWay}" Margin="0" VerticalAlignment="Bottom" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFromPeriodOptions}" Width="90" SelectedItem="{x:Bind ViewModel.SelectedAvailableFromPeriodOption, Mode=TwoWay}" Margin="6,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                                <CheckBox IsChecked="{x:Bind ViewModel.IsImmediateOccupancy, Mode=TwoWay}" Content="入居即可" Margin="0,0,0,0" VerticalAlignment="Bottom"></CheckBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <DatePicker x:Name="CurrentStatusDatePicker" Header="現況確認日" DateChanged="CurrentStatusDatePicker_DateChanged" Margin="0 0 6 6" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Button Content="本日確認" Margin="0,0,0,6" Padding="6" VerticalAlignment="Bottom" Click="SetCurrentStatusDateToToday"/>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Top" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
                
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>

