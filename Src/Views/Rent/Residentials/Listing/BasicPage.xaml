<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Listing.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mod="using:ZumenSearch.Models" 
    xmlns:modresidencial="using:ZumenSearch.Models.Rent.Residentials"
    NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">

            <StackPanel Spacing="12" Margin="0,24,0,0">

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <StackPanel>
                                <!--
                                <Border Visibility="{x:Bind ViewModel.NameHasError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ImageIcon x:Name="IconHostError" Source="ms-appx:///Assets/SvgIcons/ic_fluent_error_circle_16_color.svg" Width="16" Height="16" Margin="0,0,0,0"/>
                                        <TextBlock Text="{x:Bind ViewModel.NameErrorMessage, Mode=OneWay}" Margin="8,0,0,0"></TextBlock>
                                    </StackPanel>
                                </Border>
                                -->
                                <TextBox x:Name="TextBoxName" TabIndex="0" MinWidth="200" Header="部屋番号" PlaceholderText="必須" 
                                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderBrush="{x:Bind ViewModel.IsNameHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="間取り" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Margin="0,0,0,0" Width="130" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.FloorPlanTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFloorPlanType, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="modresidencial:ListingFloorPlanTypeLabel">
                                                        <TextBlock Text="{x:Bind Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <ComboBox Header="" Margin="6,0,0,0" Width="130" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.FloorPlanExtraTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFloorPlanExtraType, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="modresidencial:ListingFloorPlanExtraTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="専有面積（平米）" Text="{x:Bind ViewModel.FloorExclusiveAreaSqm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Width="120" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                                    <ComboBox Header="所在階" ItemsSource="{x:Bind ViewModel.FloorGroundTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFloorGroundType, Mode=TwoWay}" Margin="6,0,0,0" MinWidth="90" Width="90" HorizontalAlignment="Left" VerticalAlignment="Bottom" >
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="modresidencial:ListingFloorGroundTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Text="{x:Bind ViewModel.FloorNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ComboBox Header="主要採光面" ItemsSource="{x:Bind ViewModel.ExposureDirectionTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedExposureDirectionType, Mode=TwoWay}" Margin="12,0,0,0" MinWidth="90" Width="90" HorizontalAlignment="Left" VerticalAlignment="Bottom" >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="modresidencial:ListingExposureDirectionTypeLabel">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <CheckBox Margin="12,0,0,0" Content="角部屋" IsChecked="{x:Bind ViewModel.IsCornerRoom, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <ComboBox Header="現況" Width="170" ItemsSource="{x:Bind ViewModel.AvailabilityStatusTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityStatusType, Mode=TwoWay}" Margin="0" VerticalAlignment="Bottom" >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="modresidencial:ListingAvailabilityStatusTypeLabel">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <CheckBox Content="募集中" Margin="12,0,0,0" IsChecked="{x:Bind ViewModel.IsAvailableForRentNow, Mode=TwoWay}" VerticalAlignment="Bottom"></CheckBox>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <CalendarDatePicker x:Name="CurrentStatusDatePicker" Header="現況確認日" Date="{x:Bind ViewModel.OccupancyStatusCheckedAt, Mode=TwoWay}" Margin="0" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Button Content="本日確認" Margin="6,0,0,0" Padding="6" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ComboBox Header="入居可能日" ItemsSource="{x:Bind ViewModel.AvailabilityMonthTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityMonthType, Mode=TwoWay}" Width="100" Margin="0" VerticalAlignment="Bottom">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="modresidencial:ListingAvailabilityMonthTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailabilityPeriodTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAvailabilityPeriodType, Mode=TwoWay}" Width="90" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="modresidencial:ListingAvailabilityPeriodTypeLabel">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <CheckBox Content="即入居可" Margin="12,0,0,0" IsChecked="{x:Bind ViewModel.IsAvailableForImmediateMoveIn, Mode=TwoWay}" VerticalAlignment="Bottom"></CheckBox>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <TextBox Header="備考" Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Top" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
                
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>

