<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    xmlns:helpers="using:ZumenSearch.Helpers"
    xmlns:mod="using:ZumenSearch.Models.Common"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="KeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto" MaxHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="AppTitleBar" Margin="0,0,0,0" Canvas.ZIndex="1" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon" Grid.Row="0" Grid.Column="0" Source="/Assets/App.ico" HorizontalAlignment="Left" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"/>

            <TextBlock x:Name="AppTitleBarText" Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" VerticalAlignment="Center"/>

        </Grid>

        <Border Grid.Row="1">
            <InfoBar Severity="Error" 
             IsOpen="{x:Bind ViewModel.IsInfoBarErrorOpen, Mode=TwoWay}" 
             Message="{x:Bind ViewModel.InfoBarErrorMessage, Mode=OneWay}" />
        </Border>
        
        <Grid Grid.Row="2" Margin="36,0,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <BreadcrumbBar x:Name="BreadcrumbBar1" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}" 
                               IsHitTestVisible="False" AllowFocusOnInteraction="False" IsTabStop="False" VerticalAlignment="Center">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="mod:Breadcrumb">
                            <BreadcrumbBarItem>
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate x:DataType="mod:Breadcrumb">
                                        <TextBlock Text="{x:Bind Name}" FontSize="28" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <AppBarButton Icon="Save" Label="保存" ToolTipService.ToolTip="保存（Ctrl+S）" Command="{x:Bind ViewModel.SaveCommand}">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control"/>
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                    </StackPanel>
                </StackPanel>

            </Grid>

        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <NavigationView x:Name="NavView" Grid.Row="0" Margin="36,3,36,0" PaneDisplayMode="Top" Canvas.ZIndex="0" IsTitleBarAutoPaddingEnabled="True" SelectionFollowsFocus="Disabled" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" Loaded="NavView_Loaded" ItemInvoked="NavView_ItemInvoked" BackRequested="NavView_BackRequested">
                <NavigationView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="KeyboardAccelerator_Invoked" />
                </NavigationView.KeyboardAccelerators>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="基本" Tag="ZumenSearch.Views.Rent.Residentials.BasicPage" />
                    <NavigationViewItem Content="所在地" Tag="ZumenSearch.Views.Rent.Residentials.LocationPage" />
                    <NavigationViewItem Content="交通" Tag="ZumenSearch.Views.Rent.Residentials.TransportationPage" />
                    <NavigationViewItem Content="設備" Tag="ZumenSearch.Views.Rent.Residentials.FacilitiesPage" />
                    <NavigationViewItem Content="管理" Tag="ZumenSearch.Views.Rent.Residentials.KanriPage" />
                    <NavigationViewItem Content="写真" Tag="ZumenSearch.Views.Rent.Residentials.PictureListPage" />
                    <NavigationViewItem Content="図面" Tag="ZumenSearch.Views.Rent.Residentials.ZumenListPage" Visibility="{x:Bind ViewModel.IsUnitOwnershipVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    <NavigationViewItem Content="貸主" Tag="ZumenSearch.Views.Rent.Residentials.LessorListPage" Visibility="{x:Bind ViewModel.IsUnitOwnershipVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    <NavigationViewItem Content="宅建業者" Tag="ZumenSearch.Views.Rent.Residentials.BrokerListPage" Visibility="{x:Bind ViewModel.IsUnitOwnershipVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="部屋一覧" Tag="ZumenSearch.Views.Rent.Residentials.RoomListPage"/>
                </NavigationView.FooterMenuItems>
                
            </NavigationView>

            <Frame x:Name="ContentFrame" Grid.Row="1" NavigationFailed="ContentFrame_NavigationFailed" Navigated="ContentFrame_Navigated"/>

        </Grid>

    </Grid>
</Page>
