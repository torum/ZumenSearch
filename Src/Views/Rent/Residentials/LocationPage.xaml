<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.LocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d"
    xmlns:mod="using:ZumenSearch.Models.Common" 
    xmlns:framework="using:Microsoft.UI.Xaml"
    NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">
                <Border Style="{StaticResource RoundCardBorderStyle}">

                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="320"/>
                                <ColumnDefinition Width="1*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <ComboBox x:Name="ComboBoxPref" Header="都道府県" PlaceholderText="選択" SelectionChanged="ComboBoxPref_SelectionChanged" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Prefectures, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="mod:Prefecture">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind Name}" Margin="0,0,5,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <ComboBox x:Name="ComboBoxCountyAndCity" Header="郡+市区町村" PlaceholderText="選択" SelectionChanged="ComboBoxCountyAndCity_SelectionChanged" IsEnabled="False" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Cities, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="mod:CountyAndCity">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind Combined}" Margin="0,0,5,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="320"/>
                                <ColumnDefinition Width="1*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,12,0,0">
                                <ComboBox x:Name="ComboBoxWardAndOaza" Header="政令市区+大字・町名" PlaceholderText="選択" SelectionChanged="ComboBoxWardAndOaza_SelectionChanged" IsEnabled="False" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Towns, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="mod:WardAndOaza">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind Combined}" Margin="0,0,5,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Grid.Column="1" Margin="12,12,0,0">
                                <ComboBox x:Name="ComboBoxChoume" Header="丁目" PlaceholderText="選択" IsEnabled="False" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Chous, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedChou, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="mod:Choume">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind Chou}" Margin="0,0,5,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,12,0,0">
                                <TextBox Header="小字・番地以下" Text="{x:Bind ViewModel.Edaban, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"></TextBox>
                            </Grid>
                        </Grid>

                    </StackPanel>

                </Border>
                <Border Style="{StaticResource RoundCardBorderStyle}">

                    <StackPanel>
                        <TextBox Header="住所プレビュー" Text="{x:Bind ViewModel.AddressPreview, Mode=OneWay}" IsReadOnly="True" ></TextBox>
                    </StackPanel>

                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"/>
                            <ColumnDefinition Width="1*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox Header="緯度" Text="{x:Bind ViewModel.LocationLatitude, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        </Grid>
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Header="経度" Text="{x:Bind ViewModel.LocationLongitude, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Button Content="GoogleMapで表示" Command="{x:Bind ViewModel.ShowGoogleMapsCommand, Mode=OneWay}"/>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
