<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Bldg.UnitListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mod="using:ZumenSearch.Models"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentArea" Padding="48,0,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,24,0" HorizontalAlignment="Right">
                <AppBarButton Icon="Add" Label="追加" Command="{x:Bind ViewModel.AddNewUnitCommand}"/>
                <AppBarButton Icon="Edit" Label="編集"/>
                <AppBarButton Icon="Copy" Label="複製"/>
                <AppBarButton Icon="Delete" Label="削除" Command="{x:Bind ViewModel.DeleteSelectedBuildingPictureCommand}"/>
            </CommandBar>
        </Grid>
        
        <Grid Grid.Row="1">

        </Grid>
    </Grid>

</Page>
