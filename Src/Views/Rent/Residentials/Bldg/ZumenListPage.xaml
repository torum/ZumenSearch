<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Bldg.ZumenListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentArea" Padding="48,0,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,0,0" HorizontalAlignment="Right">
                <AppBarButton Icon="Delete" Label="削除"/>
                <AppBarButton Name="AppBarButtonReplaceZumen" Icon="Add" Label="置換"/>
                <AppBarButton Name="AppBarButtonAddZumen" Icon="Add" Label="追加"/>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1">
        </Grid>
    </Grid>
</Page>
