<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Bldg.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mod="using:ZumenSearch.Models.Common"
    xmlns:modresi="using:ZumenSearch.Models.Rent.Residentials.Bldg"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <!-- 物件名 -->
                            <StackPanel>
                                <!--
                                <Border Visibility="{x:Bind ViewModel.NameHasError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ImageIcon x:Name="IconHostError" Source="ms-appx:///Assets/SvgIcons/ic_fluent_error_circle_16_color.svg" Width="16" Height="16" Margin="0,0,0,0"/>
                                        <TextBlock Text="{x:Bind ViewModel.NameErrorMessage, Mode=OneWay}" Margin="8,0,0,0"></TextBlock>
                                    </StackPanel>
                                </Border>
                                -->
                                <TextBox x:Name="TextBoxName" TabIndex="0" MinWidth="200" Header="物件名" PlaceholderText="必須" MaxLength="200" 
                                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderBrush="{x:Bind ViewModel.IsNameHasError, Converter={StaticResource ValidationToBrushConverter}, Mode=OneWay}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <!-- 物件種目 -->
                            <ComboBox x:Name="ComboBoxKinds" Grid.Row="0" Grid.Column="0" Header="物件種目" PlaceholderText="選択" Width="200" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}" VerticalAlignment="Bottom">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="modresi:Kind">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind Label, Mode=OneTime}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <!-- 区分所有 -->
                                <CheckBox x:Name="CheckBoxUnitOwnership" Margin="12,12,0,0" Content="区分所有" IsChecked="{x:Bind ViewModel.IsUnitOwnership, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <!-- 構造 -->
                            <ComboBox Header="構造" HorizontalAlignment="Stretch" PlaceholderText="選択" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Structures, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStructure, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <!-- Needed for AOT -->
                                    <DataTemplate x:DataType="modresi:Structure">
                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- 地上・地下・総戸数 -->
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox MinWidth="87" Header="地上（階建て）" PlaceholderText="半角英数" InputScope="Number" MaxLength="10" Text="{x:Bind ViewModel.AboveGroundFloorCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"/>
                                <TextBox MinWidth="87" Header="地下（階建て）" PlaceholderText="半角英数" InputScope="Number" MaxLength="10" Text="{x:Bind ViewModel.BasementFloorCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0"/>
                                <TextBox MinWidth="87" Header="総戸数（戸）" PlaceholderText="半角英数" InputScope="Number" MaxLength="10" Text="{x:Bind ViewModel.TotalUnitCount,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <!-- 築年月（西暦 ）-->
                            <DatePicker Header="築年月（西暦）" DayVisible="False" Language="ja-JP" SelectedDate="{x:Bind ViewModel.BuiltYearAndMonth, Mode=TwoWay}" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <!-- 和暦（IsReadOnly） -->
                            <TextBox Header="築年月（和暦プレビュー）" IsReadOnly="True" IsEnabled="False" Text="{x:Bind ViewModel.BuiltYearAndMonthPreview, Mode=OneWay}" HorizontalAlignment="Left"></TextBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="320"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBox Header="不動産ID" PlaceholderText="13桁の半角英数字" MaxLength="13" InputScope="Number" Text="{x:Bind ViewModel.FudousanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Header="特定コード" PlaceholderText="4桁の半角英数字" MaxLength="4" InputScope="Number" Text="{x:Bind ViewModel.FudousanIdAdditionalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RoundCardBorderStyle}">
                    <Grid>
                        <TextBox Header="備考" 
                             Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" IsSpellCheckEnabled="False"
                             MinWidth="400" MinHeight="160" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
                
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
