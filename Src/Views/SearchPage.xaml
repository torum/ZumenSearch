<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZumenSearch.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ZumenSearch.Views"
    xmlns:mod="using:ZumenSearch.Models.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:framework="using:Microsoft.UI.Xaml"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <CollectionViewSource x:Name="cvsProjects" IsSourceGrouped="True" ItemsPath="Activities"/>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="{StaticResource ContentPadding}">
            <Grid BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <BreadcrumbBar x:Name="BreadcrumbBar1" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind ViewModel.BreadcrumbItemsRent, Mode=OneWay}" VerticalAlignment="Center">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="mod:Breadcrumb">
                            <BreadcrumbBarItem>
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate x:DataType="mod:Breadcrumb">
                                        <TextBlock Text="{x:Bind Name}" FontSize="28" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">

                        <AppBarButton Icon="Find" Label="検索" Command="{x:Bind ViewModel.SearchRentResidentialBldgCommand}" CommandParameter="{x:Bind ViewModel.SearchQuery, Mode=OneWay}"/>
                        <!--
                        <AppBarButton Icon="Add" Label="新規" Command="{x:Bind ViewModel.AddNewRentResidentialCommand}"/>
                        -->
                        <AppBarButton Icon="Add" Label="新規">
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="賃貸：住居用" Command="{x:Bind ViewModel.AddNewRentResidentialBldgCommand}"/>
                                    <MenuFlyoutItem Text="賃貸：事業用"/>
                                    <MenuFlyoutItem Text="賃貸：駐車場"/>
                                    <MenuFlyoutItem Text="貸主"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="宅建業者"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>
        
        <Grid Grid.Row="1" Padding="{StaticResource ContentPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,24,0,0" Spacing="24">

                <controls:Segmented x:Name="SegmentedControl" HorizontalAlignment="Center" SelectedIndex="{x:Bind ViewModel.SegIndex, Mode=TwoWay}" Visibility="Collapsed">
                    <controls:SegmentedItem Content="賃貸" Tag="one" />
                    <controls:SegmentedItem Content="売買" Tag="two" />
                </controls:Segmented>

                <AutoSuggestBox x:Name="SearchAutoSuggestBox" TabIndex="0" PlaceholderText="検索キーワードを入力" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find" MaxWidth="500" QuerySubmitted="AutoSuggestBox_QuerySubmitted"/>

                <controls:SwitchPresenter Value="{x:Bind ((framework:FrameworkElement)SegmentedControl.SelectedItem).Tag, Mode=OneWay}">
                    <controls:Case Value="one">
                        <VariableSizedWrapGrid x:Name="RentSearchTarget" Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="4">
                            <RadioButton Content="物件名" GroupName="RentMainSearchText" IsChecked="True" Margin="0,0,12,6"/>
                            <RadioButton Content="所在地" GroupName="RentMainSearchText"/>
                            <RadioButton Content="沿線名" GroupName="RentMainSearchText"/>
                            <RadioButton Content="最寄り駅" GroupName="RentMainSearchText"/>
                            <RadioButton Content="不動産ID" GroupName="RentMainSearchText"/>
                            <RadioButton Content="宅建業者名" GroupName="RentMainSearchText"/>
                            <RadioButton Content="貸主名" GroupName="RentMainSearchText"/>
                        </VariableSizedWrapGrid>
                    </controls:Case>
                    <controls:Case Value="two">
                        <VariableSizedWrapGrid x:Name="BuySellSearchTarget" Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="4">
                            <RadioButton Content="物件名" GroupName="BuySellMainSearchText" IsChecked="True" Margin="0,0,12,6"/>
                            <RadioButton Content="所在地" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="沿線名" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="最寄り駅" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="不動産ID" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="宅建業者名" GroupName="RentMainSearchText"/>
                        </VariableSizedWrapGrid>
                    </controls:Case>
                </controls:SwitchPresenter>

                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}"></Border>

            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!--
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1024" />
                            </VisualState.StateTriggers>

                            <VisualState.Setters>
                                <Setter Target="SearchTarget.MaximumRowsOrColumns" Value="6"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
-->

                <Grid Margin="0,24,0,0">
                    <GridView x:Name="BasicGridView" ItemsSource="{x:Bind ViewModel.RecentProperties, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="BasicGridView_ItemClick" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                    <GridView.ItemTemplate>
                            <DataTemplate x:DataType="mod:PropertySearchResultItem">
                                <Grid Width="200" Height="150" CornerRadius="4" Background="Transparent">
                                    <Image Source="{x:Bind ThumbImage, TargetNullValue={x:Null}, Mode=OneWay}" ImageFailed="Image_ImageFailed"  Stretch="UniformToFill"/>

                                    <StackPanel Orientation="Vertical" Height="40" VerticalAlignment="Bottom" Padding="5,1,5,1" Background="LightGray" Opacity=".75">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Updated: " Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid x:Name="MaxItemsWrapGrid" MaximumRowsOrColumns="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0, 5, 12, 5"/>
                        </Style>
                    </GridView.ItemContainerStyle>

<!--
                    <GridView.GroupStyle>
                        <GroupStyle HidesIfEmpty="True">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="LightGray" Margin="0">
                                        <TextBlock Text='{Binding Name}' Foreground="Black" Margin="12" Style="{StaticResource HeaderTextBlockStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    -->
                </GridView>
            </Grid>


            </ScrollViewer>

        </Grid>

    </Grid>
</Page>
