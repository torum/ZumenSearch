<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZumenSearch.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ZumenSearch.Views"
    xmlns:mod="using:ZumenSearch.Models"
    xmlns:modcommon="using:ZumenSearch.Models.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:framework="using:Microsoft.UI.Xaml"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <Page.Resources>
        <!-- DataTemplate for Rent Residential -->
        <DataTemplate x:Key="RentResidentialTemplate" x:DataType="mod:PropertySearchResultItem">
            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="ItemContainer_DoubleTapped"  PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                <ItemContainer.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                </ItemContainer.KeyboardAccelerators>
                <Border Width="240" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid Height="180">
                        <TextBlock Text="画像なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Rectangle RadiusX="3" RadiusY="3">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{x:Bind ThumbImage, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="賃貸住居用" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <Border VerticalAlignment="Bottom" Padding="10,8" CornerRadius="0,0,3,3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="更新:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <!-- DataTemplate for Rent Commercial -->
        <DataTemplate x:Key="RentCommercialTemplate" x:DataType="mod:PropertySearchResultItem">
            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="ItemContainer_DoubleTapped"  PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                <ItemContainer.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                </ItemContainer.KeyboardAccelerators>
                <Border Width="240" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid Height="180">
                        <TextBlock Text="画像なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Rectangle RadiusX="3" RadiusY="3">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{x:Bind ThumbImage, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="賃貸事業用" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <Border VerticalAlignment="Bottom" Padding="10,8" CornerRadius="0,0,3,3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="更新:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <!-- DataTemplate for Sale Residential -->
        <DataTemplate x:Key="SaleResidentialTemplate" x:DataType="mod:PropertySearchResultItem">
            <ItemContainer DataContext="{x:Bind}" IsDoubleTapEnabled="True" AllowFocusOnInteraction="False" DoubleTapped="ItemContainer_DoubleTapped"  PointerPressed="ItemContainer_PointerPressed" PointerReleased="ItemContainer_PointerReleased" RightTapped="ItemContainer_RightTapped">
                <ItemContainer.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="None" Invoked="ItemsViewKeyboardAccelerator_Invoked" />
                </ItemContainer.KeyboardAccelerators>
                <Border Width="240" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid Height="180">
                        <TextBlock Text="画像なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Rectangle RadiusX="3" RadiusY="3">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{x:Bind ThumbImage, TargetNullValue={x:Null}, Mode=OneWay}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="売買住居用" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <Border VerticalAlignment="Bottom" Padding="10,8" CornerRadius="0,0,3,3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="更新:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>


        <!-- Instantiate the Selector and reference our DataTemplates -->
        <local:RecentPropertyTypeTemplateSelector x:Key="RecentPropertyTypeTemplateSelector"
            RecentRentResidentialTemplate="{StaticResource RentResidentialTemplate}"
            RecentRentCommercialTemplate="{StaticResource RentCommercialTemplate}"
            RecentSaleResidentialTemplate="{StaticResource SaleResidentialTemplate}"/>

    </Page.Resources>
    
    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="{StaticResource ContentPadding}">
            <Grid BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <BreadcrumbBar x:Name="BreadcrumbBar1" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind ViewModel.BreadcrumbItemsRent, Mode=OneWay}" VerticalAlignment="Center">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="modcommon:Breadcrumb">
                            <BreadcrumbBarItem>
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate x:DataType="modcommon:Breadcrumb">
                                        <TextBlock Text="{x:Bind Name}" FontSize="28" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                        <AppBarButton Icon="Find" Label="検索" Command="{x:Bind ViewModel.SearchPropertiesCommand}" CommandParameter="{x:Bind ViewModel.SearchQuery, Mode=OneWay}"/>
                        <AppBarButton Icon="Add" Label="新規">
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="賃貸：住居用" Command="{x:Bind ViewModel.AddNewRentResidentialCommand}"/>
                                    <MenuFlyoutItem Text="賃貸：事業用" Command="{x:Bind ViewModel.AddNewRentCommercialCommand}"/>
                                    <MenuFlyoutItem Text="賃貸：駐車場"/>
                                    <MenuFlyoutItem Text="貸主" Command="{x:Bind ViewModel.AddNewRentLessorCommand}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="宅建業者" Command="{x:Bind ViewModel.AddNewBrokerCommand}"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource ContentPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,24,0,0" Spacing="24">

                <controls:Segmented x:Name="SegmentedControl" HorizontalAlignment="Center" SelectedIndex="{x:Bind ViewModel.SegIndex, Mode=TwoWay}" Visibility="Collapsed">
                    <controls:SegmentedItem Content="賃貸" Tag="one" />
                    <controls:SegmentedItem Content="売買" Tag="two" />
                </controls:Segmented>

                <AutoSuggestBox x:Name="SearchAutoSuggestBox" TabIndex="0" PlaceholderText="検索キーワードを入力" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find" MaxWidth="500" QuerySubmitted="AutoSuggestBox_QuerySubmitted"/>

                <controls:SwitchPresenter Value="{x:Bind ((framework:FrameworkElement)SegmentedControl.SelectedItem).Tag, Mode=OneWay}">
                    <controls:Case Value="one">
                        <VariableSizedWrapGrid x:Name="RentSearchTarget" Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="4">
                            <RadioButton Content="物件名" GroupName="RentMainSearchText" IsChecked="True" Margin="0,0,12,6"/>
                            <RadioButton Content="所在地" GroupName="RentMainSearchText"/>
                            <RadioButton Content="最寄り駅" GroupName="RentMainSearchText"/>
                            <RadioButton Content="沿線名" GroupName="RentMainSearchText"/>
                            <RadioButton Content="不動産ID" GroupName="RentMainSearchText"/>
                            <RadioButton Content="宅建業者名" GroupName="RentMainSearchText"/>
                            <RadioButton Content="貸主名" GroupName="RentMainSearchText"/>
                        </VariableSizedWrapGrid>
                    </controls:Case>
                    <controls:Case Value="two">
                        <VariableSizedWrapGrid x:Name="BuySellSearchTarget" Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="4">
                            <RadioButton Content="物件名" GroupName="BuySellMainSearchText" IsChecked="True" Margin="0,0,12,6"/>
                            <RadioButton Content="所在地" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="最寄り駅" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="沿線名" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="不動産ID" GroupName="BuySellMainSearchText"/>
                            <RadioButton Content="宅建業者名" GroupName="RentMainSearchText"/>
                        </VariableSizedWrapGrid>
                    </controls:Case>
                </controls:SwitchPresenter>

<!--                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}"></Border> -->

            </StackPanel>

            <Grid Grid.Row="1">
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="最近更新された物件" FontWeight="SemiBold" FontSize="16"/>
                    <Border Margin="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}"></Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsView x:Name="RecentItemsView" Margin="12,24,12,24" ItemTemplate="{StaticResource RecentPropertyTypeTemplateSelector}" ItemsSource="{x:Bind ViewModel.RecentProperties, Mode=OneWay}" AllowFocusOnInteraction="True" SelectionMode="Single" HorizontalAlignment="Stretch">
                    <ItemsView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="編集" Icon="Edit" Command="{x:Bind ViewModel.EditPropertyCommand}" CommandParameter="{x:Bind RecentItemsView.SelectedItem, Mode=OneWay}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="削除" Icon="Delete" Command="{x:Bind ViewModel.DeletePropertyCommand}" CommandParameter="{x:Bind RecentItemsView.SelectedItem, Mode=OneWay}"></MenuFlyoutItem>
                        </MenuFlyout>
                    </ItemsView.ContextFlyout>
                    <ItemsView.Layout>
                        <UniformGridLayout ItemsJustification="Start" MaximumRowsOrColumns="10" MinRowSpacing="24" MinColumnSpacing="24"/>
                        <!--
                        <LinedFlowLayout MinItemSpacing="24" LineSpacing="24"/>
                        -->
                        <!-- StackLayout -->
                    </ItemsView.Layout>
                </ItemsView>

            </ScrollViewer>

        </Grid>

    </Grid>
</Page>
