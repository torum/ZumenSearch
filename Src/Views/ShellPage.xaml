<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ZumenSearch.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ZumenSearch"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="KeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Height="48" IsHitTestVisible="True" VerticalAlignment="Top" Margin="0,0,0,0" SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <!-- NavigationView.PaneToggleButton: None draggable area(48px). Exclude from TitleBar -->
            </Grid>
            <Grid x:Name="AppTitleBar" Grid.Column="1">
                <!-- Application TitleBar: SetTitleBar in code behinde -->
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
            <NavigationView x:Name="NavigationViewControl" 
                            AlwaysShowHeader="False"
                            IsBackButtonVisible="Collapsed" 
                            IsPaneToggleButtonVisible="True" 
                            IsBackEnabled="True" 
                            PaneDisplayMode="Auto" 
                            ExpandedModeThresholdWidth="1007"
                            CompactModeThresholdWidth="640" 
                            OpenPaneLength ="260" 
                            IsSettingsVisible="True"  
                            IsTabStop="False" 
                            IsTitleBarAutoPaddingEnabled="False"
                            Loaded="NavigationViewControl_Loaded" 
                            ItemInvoked="NavigationViewControl_ItemInvoked" 
                            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
                            BackRequested="NavigationViewControl_BackRequested"
                            PaneOpened="NavigationViewControl_PaneOpened"
                            PaneClosed="NavigationViewControl_PaneClosed"
                            >
                <NavigationView.Resources>
                    <!-- Changes the layout box size reserved for the icon; default 16, can be 20 -->
                    <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">16</x:Double>
                </NavigationView.Resources>
                <NavigationView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                        </Grid>
                    </DataTemplate>
                </NavigationView.HeaderTemplate>
                <NavigationView.PaneHeader>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="36,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image x:Name="AppTitleBarIcon" Source="/Assets/App.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Width="18" Height="18" Margin="6,0,0,0" />
                            <TextBlock x:Name="AppTitleBarText" Text="ZumenSearch" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.9"/>
                        </StackPanel>
                    </Grid>
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>

                    <NavigationViewItem Tag="ZumenSearch.Views.SearchPage" Content="総合検索" ToolTipService.ToolTip="検索">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xe721;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Tag="Rent" Content="賃貸" ToolTipService.ToolTip="賃貸" IsExpanded="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xe838;"/>
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.MenuItems>

                            <NavigationViewItem Tag="ZumenSearch.Views.Rent.Residentials.SearchPage" Content="住居用" ToolTipService.ToolTip="賃貸住居用">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                            <NavigationViewItem Tag="ZumenSearch.Views.Rent.Commercials.CommercialsPage" Content="事業用" ToolTipService.ToolTip="賃貸事業用">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                            <NavigationViewItem Tag="ZumenSearch.Views.Rent.Parkings.ParkingsPage" Content="駐車場" ToolTipService.ToolTip="賃貸駐車場">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                            <NavigationViewItem Tag="ZumenSearch.Views.Rent.Owners.SearchPage" Content="貸主" ToolTipService.ToolTip="貸主">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>

                    <NavigationViewItem Tag="ZumenSearch.Views.Brokers.BrokersPage" Content="宅建業者" ToolTipService.ToolTip="宅建業者">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xe7c3;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                </NavigationView.MenuItems>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" SizeChanged="AppTitleBar_SizeChanged" Loaded="AppTitleBarGrid_Loaded">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Grid.Column="0" Height="36" Width="40" Margin="6,6,0,0" ToolTipService.ToolTip="Alt+Left" Style="{ThemeResource TitleBarBackButtonStyle}" IsEnabled="{x:Bind NavigationFrame.CanGoBack, Mode=OneWay}" Click="BackButton_Click" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- NavigationView content frame -->
                    <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="NavigationViewControl_Navigated" Padding="0"></Frame>
                </Grid>
            </NavigationView>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationViewControl.PaneDisplayMode" Value="Left" />
                        <!-- 
                        <Setter Target="NavigationViewControl.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NavigationViewControl.IsPaneOpen" Value="False" /> -->
                        <Setter Target="NavigationViewControl.OpenPaneLength" Value="320" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1007" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationViewControl.PaneDisplayMode" Value="Left" />
                        <!-- 
                        <Setter Target="NavigationViewControl.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NavigationViewControl.IsPaneOpen" Value="False" /> -->
                        <Setter Target="NavigationViewControl.OpenPaneLength" Value="280" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationViewControl.PaneDisplayMode" Value="LeftCompact" />
                        <!-- 
                        <Setter Target="NavigationViewControl.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NavigationViewControl.IsPaneOpen" Value="False" /> -->
                        <Setter Target="NavigationViewControl.OpenPaneLength" Value="280" />
                        <Setter Target="BackButton.Margin" Value="6,5,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="340" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationViewControl.PaneDisplayMode" Value="Auto" />
                        <!-- 
                        <Setter Target="NavigationViewControl.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NavigationViewControl.IsPaneOpen" Value="False" /> -->
                        <Setter Target="NavigationViewControl.OpenPaneLength" Value="230" />
                        <Setter Target="SearchBox.Visibility" Value="Collapsed" />
                        <Setter Target="BackButton.Margin" Value="48,4,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationViewControl.PaneDisplayMode" Value="Auto" />
                        <!-- 
                        <Setter Target="NavigationViewControl.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NavigationViewControl.IsPaneOpen" Value="False" /> -->
                        <Setter Target="NavigationViewControl.OpenPaneLength" Value="230" />
                        <Setter Target="SearchBox.Visibility" Value="Collapsed" />
                        <Setter Target="BackButton.Margin" Value="48,4,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>
</Page>
