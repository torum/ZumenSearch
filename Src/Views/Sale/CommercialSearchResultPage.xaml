<Page
    x:Class="ZumenSearch.Views.Sale.CommercialSearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="using:ZumenSearch.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="売買収益・事業用：検索結果"
            FontSize="28"
            FontWeight="SemiBold" />

        <ListView
            x:Name="ResultList"
            Grid.Row="1"
            Margin="0,24,0,0"
            SelectionMode="Single"
            DoubleTapped="ResultList_DoubleTapped">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mod:PropertySearchResultItem">
                    <Grid Padding="12">
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontSize="18" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Content="編集"
                Command="{x:Bind ViewModel.EditSaleResidentialCommand}"
                CommandParameter="{x:Bind ResultList.SelectedItem, Mode=OneWay}" />

            <Button
                Content="削除"
                Command="{x:Bind ViewModel.DeleteSaleResidentialCommand}"
                CommandParameter="{x:Bind ResultList.SelectedItem, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
