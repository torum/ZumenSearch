<Page
    x:Class="ZumenSearch.Views.Sale.Residentials.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:modcommon="using:ZumenSearch.Models.Common"
    xmlns:modresi="using:ZumenSearch.Models.Rent.Residentials"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="36,0,36,24">
        <Grid x:Name="ContentArea">
            <StackPanel Spacing="12" Margin="0,24,0,0">

                <TextBox
        Header="物件名"
        PlaceholderText="必須"
        MaxLength="100"
        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
        Header="物件種目"
        ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}"
        SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="modresi:Kind">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox
        Content="区分所有"
        IsChecked="{x:Bind ViewModel.IsUnitOwnership, Mode=TwoWay}" />

                <ComboBox
        Header="建物構造"
        ItemsSource="{x:Bind ViewModel.Structures, Mode=OneWay}"
        SelectedItem="{x:Bind ViewModel.SelectedStructure, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="modresi:Structure">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
            Grid.Column="0"
            Header="地上階数"
            InputScope="Number"
            Text="{x:Bind ViewModel.FloorCountAboveGround, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
            Grid.Column="1"
            Header="地下階数"
            InputScope="Number"
            Text="{x:Bind ViewModel.FloorCountBasement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
            Grid.Column="2"
            Header="総戸数"
            InputScope="Number"
            Text="{x:Bind ViewModel.TotalUnitCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <DatePicker
        Header="築年月"
         />
                <!-- Date="{x:Bind ViewModel.BuiltYearAndMonth, Mode=TwoWay}" -->

                <TextBox
        Header="不動産番号"
        Text="{x:Bind ViewModel.FudousanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
        Header="不動産番号追加コード"
        Text="{x:Bind ViewModel.FudousanIdAdditionalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
        Header="備考"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        MinHeight="100"
        Text="{x:Bind ViewModel.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
