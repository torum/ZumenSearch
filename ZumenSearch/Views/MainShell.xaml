<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZumenSearch.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZumenSearch.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="using:Microsoft.Xaml.Interactivity" 
    xmlns:vm="using:ZumenSearch.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.Column="0" Canvas.ZIndex="1" Height="46" IsHitTestVisible="True" VerticalAlignment="Top" Margin="0,0,0,0">
            <Image Source="/Assets/App.ico"
                    x:Name="AppTitleBarIcon"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Width="18"
                   Height="18"
                   Margin="12,0,0,0" />
            <TextBlock x:Name="AppTitleBarText"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="36,0,0,0"
                       Text="図面検索"/>
        </Grid>
        
        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
            <!--  BorderBrush="{ThemeResource SmokeFillColorDefaultBrush}" -->
            <NavigationView x:Name="NavigationViewControl" Loaded="NavigationViewControl_Loaded" ItemInvoked="NavigationViewControl_ItemInvoked" Canvas.ZIndex="0" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}" IsSettingsVisible="True" ExpandedModeThresholdWidth="1280" OpenPaneLength ="200" DisplayModeChanged="NavigationViewControl_DisplayModeChanged">
                <!--
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox QueryIcon="Find" AutomationProperties.Name="Search" PlaceholderText="Type a name">
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            -->
                <NavigationView.MenuItems>

                    <!--
                    <NavigationViewItemHeader Content="賃貸"/>

                    <NavigationViewItemSeparator />
                    
                    <NavigationViewItem Tag="RentResidentials" Content="住居用" ToolTipService.ToolTip="賃貸住居用">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Tag="RentCommercials" Content="事業用" ToolTipService.ToolTip="賃貸事業用">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Tag="RentParkings" Content="駐車場" ToolTipService.ToolTip="賃貸駐車場">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator />

                    <NavigationViewItem Tag="RentOwners" Content="貸主" ToolTipService.ToolTip="貸主" Icon="OtherUser"/>
                    -->

                    <NavigationViewItem Tag="Rent" Content="賃貸" ToolTipService.ToolTip="賃貸" IsExpanded="True">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe80f;"/>
                        </NavigationViewItem.Icon>

                        <NavigationViewItem.MenuItems>

                            <NavigationViewItem Tag="RentResidentials" Content="住居用" ToolTipService.ToolTip="賃貸住居用">
                                <NavigationViewItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                            <NavigationViewItem Tag="RentCommercials" Content="事業用" ToolTipService.ToolTip="賃貸事業用">
                                <NavigationViewItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                            <NavigationViewItem Tag="RentParkings" Content="駐車場" ToolTipService.ToolTip="賃貸駐車場">
                                <NavigationViewItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7c3;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>

                            <NavigationViewItemSeparator />

                            <NavigationViewItem Tag="RentOwners" Content="貸主" ToolTipService.ToolTip="貸主" Icon="OtherUser"/>

                        </NavigationViewItem.MenuItems>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator />
                    <NavigationViewItem Tag="Brokers" Content="宅建業者" ToolTipService.ToolTip="宅建業者" Icon="OtherUser">
                    </NavigationViewItem>

                </NavigationView.MenuItems>

                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Frame x:Name="NavigationFrame" NavigationFailed="NavigationFrame_NavigationFailed"/>
                </Grid>

            </NavigationView>
        </Grid>
    </Grid>
</Page>
