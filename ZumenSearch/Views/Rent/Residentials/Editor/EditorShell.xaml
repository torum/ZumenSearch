<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Editor.EditorShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    xmlns:helpers="using:ZumenSearch.Helpers"
    xmlns:mod="using:ZumenSearch.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="AppTitleBar" Margin="0,0,0,0" Canvas.ZIndex="1" IsHitTestVisible="False" Height="46" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Width="0">
                <!-- Dummy for toggle button -->
            </Grid>
            
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">

                <Image x:Name="AppTitleBarIcon" Source="/Assets/App.ico" HorizontalAlignment="Left" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="AppTitleBarText" Text="賃貸住居用" TextWrapping="NoWrap"  Margin="12,0,0,0" VerticalAlignment="Center"/>

            </StackPanel>

            <Grid Grid.Row="0" Grid.Column="2"></Grid>

        </Grid>

        <Grid Grid.Row="1" Margin="48,0,48,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource NavigationViewItemSeparatorForeground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <BreadcrumbBar x:Name="BreadcrumbBar1" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="mod:Breadcrumb">
                            <BreadcrumbBarItem Content="{Binding}">
                                <BreadcrumbBarItem.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="32" />
                                    </DataTemplate>
                                </BreadcrumbBarItem.ContentTemplate>
                            </BreadcrumbBarItem>
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <AppBarButton Icon="Save" Label="保存" Command="{x:Bind ViewModel.SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
                
            </Grid>
            
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <NavigationView x:Name="NavView" Grid.Row="0" Margin="48,6,48,0" PaneDisplayMode="Top" Canvas.ZIndex="0" IsTitleBarAutoPaddingEnabled="True" SelectionFollowsFocus="Disabled" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" Loaded="NavView_Loaded" ItemInvoked="NavView_ItemInvoked">
                <!--   BackRequested="NavView_BackRequested" -->
                <NavigationView.MenuItems>
                    <!-- <NavigationViewItemHeader Content="賃貸：住居用"/>
                    <NavigationViewItemSeparator />  -->
                    <NavigationViewItem Content="基本" Tag="summary" />
                    <NavigationViewItem Content="所在地" Tag="location" />
                    <NavigationViewItem Content="交通" Tag="transportation" />
                    <NavigationViewItem Content="設備" Tag="appliance" />
                    <NavigationViewItem Content="写真" Tag="pictures" />
                    <NavigationViewItem Content="部屋" Tag="units"/>
                    <!-- <NavigationViewItem Content="備考" Tag="memo" /> -->
                    <NavigationViewItem x:Name="NavigationViewItemZumen" Content="図面" Tag="zumen"/>
                    <NavigationViewItem x:Name="NavigationViewItemKasinusi" Content="貸主" Tag="kasinusi"/>
                    <NavigationViewItem x:Name="NavigationViewItemGyousya" Content="宅建業者" Tag="gyousya"/>
                </NavigationView.MenuItems>
            </NavigationView>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="48,0,48,24">
                <Frame x:Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed"/>
            </ScrollViewer>
            
        </Grid>
        
    </Grid>
</Page>
