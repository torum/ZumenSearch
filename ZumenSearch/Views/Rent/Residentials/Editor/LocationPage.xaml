<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Editor.LocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d"
    xmlns:modpref="using:ZumenSearch.Models.Location"
    xmlns:mod="using:ZumenSearch.Models"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentArea">
        <StackPanel Spacing="12" Margin="0,24,0,0">

            <Border Style="{StaticResource RoundCardBorderStyle}">

                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="360"/>
                            <ColumnDefinition Width="1*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <ComboBox Header="都道府県" ItemsSource="{x:Bind ViewModel.Prefs, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="選択" SelectedIndex="-1" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="modpref:Pref">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind Name}" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Header="市区町村" Text="{x:Bind ViewModel.CityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"></TextBox>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="360"/>
                            <ColumnDefinition Width="1*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,12,0,0">
                            <TextBox Header="町名" Text="{x:Bind ViewModel.TownName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"></TextBox>
                        </Grid>
                        <Grid Grid.Column="1" Margin="12,12,0,0">
                            <TextBox Header="丁目" Text="{x:Bind ViewModel.Choume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"></TextBox>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,12,0,0">
                            <TextBox Header="番地以下" Text="{x:Bind ViewModel.Banchi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"></TextBox>

                        </Grid>
                    </Grid>

                    <StackPanel>

                        <!-- 
<GroupBox Header="所在地詳細" Padding="0" Style="{DynamicResource GroupBoxStyle}">

    <Button VerticalAlignment="Center" Content="所在地設定" Margin="6" Padding="3" Width="120" HorizontalAlignment="Left" />

</GroupBox>

<GroupBox Header="地図表示" Padding="0" Style="{DynamicResource GroupBoxStyle}">

    <Button Content="マップ座標取得" Command="{Binding ShowInMapCommand}" VerticalAlignment="Center" Margin="6" Padding="3" Width="120" HorizontalAlignment="Left" />

</GroupBox>

-->
                    </StackPanel>

                </StackPanel>
                
            </Border>
            <Border Style="{StaticResource RoundCardBorderStyle}">

                <StackPanel>
                    <TextBox Header="住所プレビュー" Text="{x:Bind ViewModel.AddressPreview, Mode=OneWay}" IsReadOnly="True" ></TextBox>
                </StackPanel>

            </Border>
        </StackPanel>
    </Grid>
</Page>
