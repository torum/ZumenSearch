<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Editor.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mod="using:ZumenSearch.Models"
    xmlns:modres="using:ZumenSearch.Models.Rent.Residentials"
    NavigationCacheMode="Required">
    <Grid x:Name="ContentArea">
        <StackPanel Spacing="12" Margin="0,24,0,0">

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="360"></ColumnDefinition>
                        <ColumnDefinition Width="1*" MinWidth="360"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0">
                        <TextBox Header="物件名" PlaceholderText="" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboBoxKinds" Grid.Row="0" Grid.Column="0" Header="物件種目" PlaceholderText="選択" Width="200" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="modres:Kind">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind Label}" Margin="0,0,5,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,12,0,0">
                            <CheckBox Content="区分所有" IsChecked="{x:Bind ViewModel.IsUnitOwnership, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="360"></ColumnDefinition>
                            <ColumnDefinition Width="1*" MinWidth="360"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <ComboBox Header="構造" HorizontalAlignment="Stretch" PlaceholderText="選択" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.Structures, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <NumberBox MinWidth="87" Header="地上（階建て）" Value="{x:Bind ViewModel.AboveGroundFloorCount, Mode=TwoWay}" Margin="0,0,0,0"/>
                                <NumberBox MinWidth="87" Header="地下（階建て）" Value="{x:Bind ViewModel.BasementFloorCount, Mode=TwoWay}" Margin="12,0,0,0"/>
                                <NumberBox MinWidth="87" Header="総戸数（戸）" Value="{x:Bind ViewModel.TotalUnitCount,Mode=TwoWay}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <DatePicker Header="築年月（西暦）" DayVisible="False" SelectedDate="{x:Bind ViewModel.SelectedBuildingBuiltMonthYear, Mode=TwoWay}"/>
                        </Grid>

                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="*" MinWidth="360"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="管理" VerticalAlignment="Center"></TextBlock>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="24,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="貸主" GroupName="Tatemonokanri" IsChecked="{x:Bind ViewModel.IsKanriOwnerOptionSelected, Mode=TwoWay}"/>
                                <RadioButton Content="自社" GroupName="Tatemonokanri" IsChecked="{x:Bind ViewModel.IsKanriJisyaOptionSelected, Mode=TwoWay}"/>
                                <RadioButton Content="他社" GroupName="Tatemonokanri" IsChecked="{x:Bind ViewModel.IsKanriTasyaOptionSelected, Mode=TwoWay}" Name="RbTatemonoKanriTasha"/>
                                <RadioButton Content="未指定" GroupName="Tatemonokanri" IsChecked="{x:Bind ViewModel.IsKanriUnspecifiedOptionSelected, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0" Visibility="{Binding IsChecked, Mode=OneWay, ElementName=RbTatemonoKanriTasha}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"></ColumnDefinition>
                                <ColumnDefinition Width="*" MinWidth="360"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="管理会社名" VerticalAlignment="Center"></TextBlock>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1" Margin="24,12,0,0">
                                <TextBox MinWidth="300" Text=""></TextBox>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="管理会社連絡先" VerticalAlignment="Center"></TextBlock>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" Margin="24,12,0,0">
                                <TextBox MinWidth="300"></TextBox>
                            </Grid>
                        </Grid>

                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel>
                    <TextBox Header="備考" 
                             Text="{x:Bind ViewModel.TatemonoMemo, Mode=TwoWay}"
                             TextWrapping="Wrap" AcceptsReturn="True" IsSpellCheckEnabled="False"
                             MinWidth="400" MinHeight="160" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
