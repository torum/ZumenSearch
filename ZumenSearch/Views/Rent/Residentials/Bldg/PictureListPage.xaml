<Page
    x:Class="ZumenSearch.Views.Rent.Residentials.Bldg.PictureListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="using:ZumenSearch.Models"
    xmlns:modresi="using:ZumenSearch.Models.Rent.Residentials"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentArea" Padding="48,0,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,0,24,0" HorizontalAlignment="Right">
                <AppBarButton Name="AppBarButtonAddPicture" Icon="Add" Label="追加" Command="{x:Bind ViewModel.AddNewBuildingPicturesCommand}"/>
                <AppBarButton Icon="Delete" Label="削除" Command="{x:Bind ViewModel.DeleteSelectedBuildingPictureCommand}"/>
                <!--  Command="{x:Bind ViewModel.DeleteRentResidentialCommand}" CommandParameter="{x:Bind SearchResult.SelectedItem, Mode=OneWay}" -->
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <ItemsView ItemsSource="{x:Bind ViewModel.BuildingPictures, Mode=TwoWay}" SelectionChanged="ItemsView_SelectionChanged" MinWidth="300" MinHeight="225" ScrollViewer.HorizontalScrollMode="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionMode="Single" IsItemInvokedEnabled="False">
                    <ItemsView.ItemTemplate>
                        <DataTemplate  x:DataType="modresi:PictureBuilding">
                            <ItemContainer>
                                <Grid>
                                    <Image Source="{x:Bind ImageLocation}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280" MaxWidth="280" MaxHeight="210" MinHeight="210"/>
                                    <StackPanel Orientation="Vertical" Height="60" VerticalAlignment="Bottom" Padding="12" Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}" Opacity=".75">
                                        <TextBlock Text="{x:Bind PictureType.Label, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PictureType.Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>

                    </ItemsView.ItemTemplate>
                    <ItemsView.Layout>
                        <UniformGridLayout MinRowSpacing="18" MinColumnSpacing="18"/>
                    </ItemsView.Layout>
                </ItemsView>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Visibility="{x:Bind ViewModel.IsBuildingPictureEditPaneVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource RoundCardBorderStyle}">
                <StackPanel Spacing="12" Margin="6,0,6,6" MinWidth="260">

                    <ComboBox x:Name="ComboBoxKinds" Header="タイプ" PlaceholderText="選択" Width="200" SelectedIndex="-1" ItemsSource="{x:Bind ViewModel.BuildingPictureTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedBuildingPictureType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="modresi:BuildingPictureType">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Bind Label}" Margin="0,0,5,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Header="説明" Text="{x:Bind ViewModel.BuildingPictureDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                    <CheckBox Content="メインの写真" IsChecked="{x:Bind ViewModel.BuildingPictureIsMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>

                    <Button Content="更新" Command="{x:Bind ViewModel.UpdatedBuildingPicturePropertyCommand}" HorizontalAlignment="Right"></Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
